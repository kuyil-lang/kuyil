// SQLite Backend Implementation for Generic ORM
// Uses prepared statements with parameter binding to prevent SQL injection

import "sqlite"

// ═══════════════════════════════════════════════════════════
// SQLite Connection Management
// ═══════════════════════════════════════════════════════════

struct SQLiteBackend {
    handle,
    connected,
    last_error
}

fn sqlite_connect(config) {
    let backend = SQLiteBackend {
        handle: -1,
        connected: false,
        last_error: ""
    }
    
    let file_path = config.file_path or "database.db"
    let flags = 6  // SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE
    
    let handle = kyl_sqlite_open_database(file_path, flags)
    if (handle >= 0) {
        backend.handle = handle
        backend.connected = true
        print("✓ SQLite connected: " + file_path)
    } else {
        backend.last_error = "Failed to open SQLite database"
        print("✗ SQLite connection failed")
    }
    
    return backend
}

fn sqlite_disconnect(backend) {
    if (backend.connected) {
        kyl_sqlite_close_database(backend.handle)
        backend.connected = false
        print("✓ SQLite disconnected")
        return true
    }
    return false
}

fn sqlite_execute_sql(backend, sql) {
    if (!backend.connected) {
        backend.last_error = "Not connected to database"
        return false
    }
    
    let result = kyl_sqlite_execute_sql(backend.handle, sql)
    return result == 0
}

// ═══════════════════════════════════════════════════════════
// Prepared Statement Operations (SQL Injection Safe)
// ═══════════════════════════════════════════════════════════

struct PreparedStatement {
    handle,
    param_count,
    params
}

fn sqlite_prepare(backend, query) {
    if (!backend.connected) {
        return false
    }
    
    // For now, we'll use simple query execution
    // TODO: Implement actual prepared statements when available
    return PreparedStatement {
        handle: backend.handle,
        param_count: 0,
        params: []
    }
}

fn sqlite_bind_param(stmt, index, value, type) {
    // Store parameters for later substitution
    if (!stmt.params) {
        stmt.params = []
    }
    stmt.params[index - 1] = {
        value: value,
        type: type
    }
    return true
}

fn sqlite_execute_prepared(backend, stmt, query) {
    // Build safe query with escaped parameters
    let safe_query = query
    let i = 0
    
    while (i < array_length(stmt.params)) {
        let param = stmt.params[i]
        let safe_value = sqlite_escape_value(param.value, param.type)
        safe_query = string_replace(safe_query, "?", safe_value, 1)
        i = i + 1
    }
    
    if (backend.config and backend.config.log_queries) {
        print("[SQL] " + safe_query)
    }
    
    return kyl_sqlite_execute_query(backend.handle, safe_query)
}

fn sqlite_escape_value(value, type) {
    if (type == "string") {
        // Escape single quotes by doubling them
        let escaped = string_replace(value, "'", "''")
        return "'" + escaped + "'"
    } else if (type == "int" or type == "float") {
        return to_string(value)
    } else if (type == "bool") {
        return value ? "1" : "0"
    } else if (type == "null") {
        return "NULL"
    }
    return "'" + to_string(value) + "'"
}

// ═══════════════════════════════════════════════════════════
// ORM Entity Operations for SQLite
// ═══════════════════════════════════════════════════════════

fn sqlite_create_table(backend, entity_name) {
    let decorators = @get(entity_name)
    if (!decorators) {
        backend.last_error = "No decorators found for entity: " + entity_name
        return false
    }
    
    // Get table name from @table decorator
    let table_name = entity_name
    let i = 0
    while (i < array_length(decorators)) {
        let dec = decorators[i]
        if (dec.name == "table" and dec.args and array_length(dec.args) > 0) {
            table_name = dec.args[0]
            break
        }
        i = i + 1
    }
    
    // For now, use entity-specific table creation
    // TODO: Build CREATE TABLE dynamically from decorators
    
    if (entity_name == "User") {
        let sql = "CREATE TABLE IF NOT EXISTS " + table_name + " (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            email TEXT UNIQUE NOT NULL,
            age INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )"
        return sqlite_execute_sql(backend, sql)
    } else if (entity_name == "Post") {
        let sql = "CREATE TABLE IF NOT EXISTS " + table_name + " (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            content TEXT NOT NULL,
            user_id INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )"
        return sqlite_execute_sql(backend, sql)
    }
    
    return false
}

fn sqlite_insert(backend, table_name, data) {
    if (!backend.connected) {
        return -1
    }
    
    // Build parameterized INSERT query
    let columns = []
    let placeholders = []
    let values = []
    
    let keys = map_keys(data)
    let i = 0
    while (i < array_length(keys)) {
        let key = keys[i]
        let value = data[key]
        
        columns[i] = key
        placeholders[i] = "?"
        values[i] = value
        i = i + 1
    }
    
    let col_str = array_join(columns, ", ")
    let ph_str = array_join(placeholders, ", ")
    let query = "INSERT INTO " + table_name + " (" + col_str + ") VALUES (" + ph_str + ")"
    
    // Prepare and bind
    let stmt = sqlite_prepare(backend, query)
    i = 0
    while (i < array_length(values)) {
        let value = values[i]
        let type = type_of(value)
        sqlite_bind_param(stmt, i + 1, value, type)
        i = i + 1
    }
    
    // Execute
    let result = sqlite_execute_prepared(backend, stmt, query)
    
    if (result >= 0) {
        print("✓ Inserted into " + table_name)
        return result  // Return last insert ID
    }
    
    return -1
}

fn sqlite_find_all(backend, table_name) {
    if (!backend.connected) {
        return []
    }
    
    let query = "SELECT * FROM " + table_name
    let result = kyl_sqlite_execute_query(backend.handle, query)
    
    if (result < 0) {
        backend.last_error = "Query failed"
        return []
    }
    
    // Note: Row iteration not fully working yet, return result handle
    return result
}

fn sqlite_find_by_id(backend, table_name, id) {
    if (!backend.connected) {
        return false
    }
    
    let query = "SELECT * FROM " + table_name + " WHERE id = ?"
    let stmt = sqlite_prepare(backend, query)
    sqlite_bind_param(stmt, 1, id, "int")
    
    let result = sqlite_execute_prepared(backend, stmt, query)
    
    if (result >= 0) {
        return result  // Return result handle
    }
    
    return false
}

fn sqlite_find_where(backend, table_name, conditions) {
    if (!backend.connected) {
        return []
    }
    
    // Build WHERE clause with parameters
    let where_parts = []
    let values = []
    let keys = map_keys(conditions)
    
    let i = 0
    while (i < array_length(keys)) {
        let key = keys[i]
        where_parts[i] = key + " = ?"
        values[i] = conditions[key]
        i = i + 1
    }
    
    let where_str = array_join(where_parts, " AND ")
    let query = "SELECT * FROM " + table_name + " WHERE " + where_str
    
    let stmt = sqlite_prepare(backend, query)
    i = 0
    while (i < array_length(values)) {
        sqlite_bind_param(stmt, i + 1, values[i], type_of(values[i]))
        i = i + 1
    }
    
    return sqlite_execute_prepared(backend, stmt, query)
}

fn sqlite_update(backend, table_name, id, data) {
    if (!backend.connected) {
        return false
    }
    
    let set_parts = []
    let values = []
    let keys = map_keys(data)
    
    let i = 0
    while (i < array_length(keys)) {
        let key = keys[i]
        set_parts[i] = key + " = ?"
        values[i] = data[key]
        i = i + 1
    }
    
    let set_str = array_join(set_parts, ", ")
    let query = "UPDATE " + table_name + " SET " + set_str + " WHERE id = ?"
    
    let stmt = sqlite_prepare(backend, query)
    i = 0
    while (i < array_length(values)) {
        sqlite_bind_param(stmt, i + 1, values[i], type_of(values[i]))
        i = i + 1
    }
    sqlite_bind_param(stmt, array_length(values) + 1, id, "int")
    
    let result = sqlite_execute_prepared(backend, stmt, query)
    return result >= 0
}

fn sqlite_delete(backend, table_name, id) {
    if (!backend.connected) {
        return false
    }
    
    let query = "DELETE FROM " + table_name + " WHERE id = ?"
    let stmt = sqlite_prepare(backend, query)
    sqlite_bind_param(stmt, 1, id, "int")
    
    let result = sqlite_execute_prepared(backend, stmt, query)
    return result >= 0
}

fn sqlite_count(backend, table_name) {
    if (!backend.connected) {
        return 0
    }
    
    let query = "SELECT COUNT(*) FROM " + table_name
    let result = kyl_sqlite_execute_query(backend.handle, query)
    
    // TODO: Extract count from result
    return result
}
