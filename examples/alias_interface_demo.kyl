// Demo for string .length property and str functions

import "interfaces/interface_str.kyl"

let s = "ABC"
print("s.length:", s.length)
print("str.length:", str.length(s))
print("str.upper:", str.upper(s))
print("str.lower:", str.lower("XYZ"))
print("str.substring:", str.substring("Hello World", 0, 5))
