// Demo for @alias within interface and string .length/.data
@loadlib("./libs/libkylstr.so")
@loadlib("./libs/libkyltranscoder.so")

// Define an ad-hoc interface with alias for gzip as "gz"
interface compress {
  @alias("gz")
  object gzip(input: string)
}

print("Has gz alias?", gz != nil)

let s = "ABC"
print("s.length:", s.length)
let bytes = s.data
print("bytes len:", bytes.length)
print("first byte:", bytes[0])
