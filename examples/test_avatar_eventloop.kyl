// Minimal test: Does avatar work in a simple event loop?

import "interfaces/interface_system.kyl"
import "interfaces/interface_eventloop.kyl"

let result = ""

fn worker() {
    print("[Worker] Running in avatar!")
    return "DONE"  // Return instead of setting global
}

fn main() {
    print("=== Avatar Event Loop Test ===\n")
    
    print("[Main] Spawning avatar...")
    let handle = avatar worker()
    
    print("[Main] Using await to get result...")
    let result = await handle
    
    print("[Main] Got result: " + result)
    print("SUCCESS!")
}

main()
