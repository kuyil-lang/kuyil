// Professional Chart Rendering with Smooth Curves and Better Typography
import "image"

print("=== Professional Chart Rendering ===\n\n")

// ===== BETTER TYPOGRAPHY =====

// 5x7 pixel font for better readability
fn draw_char(img, x, y, char, r, g, b) {
    // A
    if char == 65 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 6, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 6, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
    }
    // D
    if char == 68 {
        fill_rect(img, x, y, 1, 7, r, g, b)
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 5, r, g, b)
    }
    // E
    if char == 69 {
        fill_rect(img, x, y, 1, 7, r, g, b)
        fill_rect(img, x + 1, y, 4, 1, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
        fill_rect(img, x + 1, y + 6, 4, 1, r, g, b)
    }
    // I
    if char == 73 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x + 2, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    }
    // L
    if char == 76 {
        fill_rect(img, x, y, 1, 7, r, g, b)
        fill_rect(img, x + 1, y + 6, 4, 1, r, g, b)
    }
    // N
    if char == 78 {
        fill_rect(img, x, y, 1, 7, r, g, b)
        fill_rect(img, x + 1, y + 1, 1, 1, r, g, b)
        fill_rect(img, x + 2, y + 2, 1, 2, r, g, b)
        fill_rect(img, x + 3, y + 4, 1, 1, r, g, b)
        fill_rect(img, x + 4, y, 1, 7, r, g, b)
    }
    // O
    if char == 79 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    }
    // R
    if char == 82 {
        fill_rect(img, x, y, 1, 7, r, g, b)
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 2, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
        fill_rect(img, x + 3, y + 4, 1, 1, r, g, b)
        fill_rect(img, x + 4, y + 5, 1, 2, r, g, b)
    }
    // S
    if char == 83 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 2, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 4, 1, 2, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    }
    // T
    if char == 84 {
        fill_rect(img, x, y, 5, 1, r, g, b)
        fill_rect(img, x + 2, y + 1, 1, 6, r, g, b)
    }
    // V
    if char == 86 {
        fill_rect(img, x, y, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 5, 1, 1, r, g, b)
        fill_rect(img, x + 2, y + 6, 1, 1, r, g, b)
        fill_rect(img, x + 3, y + 5, 1, 1, r, g, b)
        fill_rect(img, x + 4, y, 1, 5, r, g, b)
    }
    // a (lowercase)
    if char == 97 {
        fill_rect(img, x + 1, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 3, 1, 4, r, g, b)
        fill_rect(img, x, y + 3, 1, 3, r, g, b)
        fill_rect(img, x + 1, y + 4, 3, 1, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    }
    // i (lowercase)
    if char == 105 {
        fill_rect(img, x + 2, y, 1, 1, r, g, b)
        fill_rect(img, x + 2, y + 2, 1, 5, r, g, b)
    }
    // n (lowercase)
    if char == 110 {
        fill_rect(img, x, y + 2, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 3, 1, 4, r, g, b)
    }
    // r (lowercase)
    if char == 114 {
        fill_rect(img, x, y + 2, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 3, 1, 1, r, g, b)
    }
    // t (lowercase)
    if char == 116 {
        fill_rect(img, x + 1, y, 1, 7, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 2, y + 6, 2, 1, r, g, b)
    }
}

fn draw_text(img, x, y, text, r, g, b) {
    let i = 0
    let offset = 0
    // "Train" = 84,114,97,105,110
    if text == 1 {
        draw_char(img, x, y, 84, r, g, b)
        draw_char(img, x + 6, y, 114, r, g, b)
        draw_char(img, x + 12, y, 97, r, g, b)
        draw_char(img, x + 18, y, 105, r, g, b)
        draw_char(img, x + 24, y, 110, r, g, b)
    }
    // "Valid" = 86,97,108,105,100
    if text == 2 {
        draw_char(img, x, y, 86, r, g, b)
        draw_char(img, x + 6, y, 97, r, g, b)
        draw_char(img, x + 12, y, 76, r, g, b)
        draw_char(img, x + 18, y, 105, r, g, b)
        draw_char(img, x + 24, y, 68, r, g, b)
    }
    // "Loss" = 76,111,115,115
    if text == 3 {
        draw_char(img, x, y, 76, r, g, b)
        draw_char(img, x + 6, y, 79, r, g, b)
        draw_char(img, x + 12, y, 83, r, g, b)
        draw_char(img, x + 18, y, 83, r, g, b)
    }
    // "Epoch" = 69,112,111,99,104
    if text == 4 {
        draw_char(img, x, y, 69, r, g, b)
    }
}

// ===== SMOOTH CURVE DRAWING =====

// Quadratic Bezier curve for smooth lines
fn draw_bezier_segment(img, x0, y0, x1, y1, x2, y2, r, g, b, w, h) {
    let steps = 20
    let t = 0.0
    let dt = 1.0 / steps
    
    let prev_x = x0
    let prev_y = y0
    
    let step = 0
    while step <= steps {
        // Bezier formula: B(t) = (1-t)²P0 + 2(1-t)tP1 + t²P2
        let t_sq = t * t
        let one_minus_t = 1.0 - t
        let one_minus_t_sq = one_minus_t * one_minus_t
        
        let bx = (one_minus_t_sq * x0) + (2.0 * one_minus_t * t * x1) + (t_sq * x2)
        let by = (one_minus_t_sq * y0) + (2.0 * one_minus_t * t * y1) + (t_sq * y2)
        
        // Draw line from previous point to current
        if step > 0 {
            draw_straight_line(img, prev_x, prev_y, bx, by, r, g, b, w, h)
        }
        
        prev_x = bx
        prev_y = by
        t = t + dt
        step = step + 1
    }
}

fn draw_straight_line(img, x0, y0, x1, y1, r, g, b, width, height) {
    // Bresenham with clipping
    if x0 < 0 { x0 = 0 }
    if x0 >= width { x0 = width - 1 }
    if y0 < 0 { y0 = 0 }
    if y0 >= height { y0 = height - 1 }
    if x1 < 0 { x1 = 0 }
    if x1 >= width { x1 = width - 1 }
    if y1 < 0 { y1 = 0 }
    if y1 >= height { y1 = height - 1 }
    
    let dx = x1 - x0
    if dx < 0 { dx = 0 - dx }
    let dy = y1 - y0
    if dy < 0 { dy = 0 - dy }
    
    let sx = 1
    if x0 > x1 { sx = 0 - 1 }
    let sy = 1
    if y0 > y1 { sy = 0 - 1 }
    
    let err = dx - dy
    let x = x0
    let y = y0
    
    let max_iters = 2000
    let iter = 0
    
    while iter < max_iters {
        if x >= 0 {
            if x < width {
                if y >= 0 {
                    if y < height {
                        image_set_pixel(img, x, y, r, g, b, 255)
                    }
                }
            }
        }
        
        if x == x1 {
            if y == y1 {
                iter = max_iters
            }
        }
        
        let e2 = 2 * err
        if e2 > (0 - dy) {
            err = err - dy
            x = x + sx
        }
        if e2 < dx {
            err = err + dx
            y = y + sy
        }
        iter = iter + 1
    }
}

fn fill_rect(img, x, y, w, h, r, g, b) {
    let i = 0
    while i < w {
        let j = 0
        while j < h {
            image_set_pixel(img, x + i, y + j, r, g, b, 255)
            j = j + 1
        }
        i = i + 1
    }
}

fn draw_circle(img, cx, cy, radius, r, g, b) {
    let y = 0 - radius
    while y <= radius {
        let x = 0 - radius
        while x <= radius {
            let dist = (x * x) + (y * y)
            let r_sq = radius * radius
            if dist <= r_sq {
                image_set_pixel(img, cx + x, cy + y, r, g, b, 255)
            }
            x = x + 1
        }
        y = y + 1
    }
}

// Better number rendering
fn draw_number(img, x, y, num, r, g, b) {
    if num == 0 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    } else if num == 1 {
        fill_rect(img, x + 2, y, 1, 7, r, g, b)
        fill_rect(img, x + 1, y + 1, 1, 1, r, g, b)
    } else if num == 2 {
        fill_rect(img, x, y, 5, 1, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 2, r, g, b)
        fill_rect(img, x, y + 3, 5, 1, r, g, b)
        fill_rect(img, x, y + 4, 1, 2, r, g, b)
        fill_rect(img, x, y + 6, 5, 1, r, g, b)
    } else if num == 3 {
        fill_rect(img, x, y, 5, 1, r, g, b)
        fill_rect(img, x + 4, y, 1, 7, r, g, b)
        fill_rect(img, x, y + 3, 4, 1, r, g, b)
        fill_rect(img, x, y + 6, 5, 1, r, g, b)
    } else if num == 4 {
        fill_rect(img, x, y, 1, 4, r, g, b)
        fill_rect(img, x, y + 3, 5, 1, r, g, b)
        fill_rect(img, x + 4, y, 1, 7, r, g, b)
    } else if num == 5 {
        fill_rect(img, x, y, 5, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 2, r, g, b)
        fill_rect(img, x, y + 3, 4, 1, r, g, b)
        fill_rect(img, x + 4, y + 4, 1, 2, r, g, b)
        fill_rect(img, x, y + 6, 5, 1, r, g, b)
    } else if num == 6 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
        fill_rect(img, x + 4, y + 4, 1, 2, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    } else if num == 7 {
        fill_rect(img, x, y, 5, 1, r, g, b)
        fill_rect(img, x + 4, y, 1, 7, r, g, b)
    } else if num == 8 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    } else if num == 9 {
        fill_rect(img, x + 1, y, 3, 1, r, g, b)
        fill_rect(img, x, y + 1, 1, 2, r, g, b)
        fill_rect(img, x + 4, y + 1, 1, 5, r, g, b)
        fill_rect(img, x + 1, y + 3, 3, 1, r, g, b)
        fill_rect(img, x + 1, y + 6, 3, 1, r, g, b)
    } else if num >= 10 {
        let tens = num / 10
        let ones = num % 10
        draw_number(img, x, y, tens, r, g, b)
        draw_number(img, x + 7, y, ones, r, g, b)
    }
}

// ===== PROFESSIONAL CHART FUNCTION =====

fn create_professional_chart(width, height, data1, data2, len) {
    let img = image_create(width, height, 3)
    
    // Light gray background for better contrast
    let i = 0
    while i < width {
        let j = 0
        while j < height {
            image_set_pixel(img, i, j, 248, 248, 250, 255)
            j = j + 1
        }
        i = i + 1
    }
    
    let margin_left = 80
    let margin_right = 40
    let margin_top = 60
    let margin_bottom = 70
    let chart_width = width - margin_left - margin_right
    let chart_height = height - margin_top - margin_bottom
    
    // White chart area
    fill_rect(img, margin_left, margin_top, chart_width, chart_height, 255, 255, 255)
    
    let axis_x0 = margin_left
    let axis_y0 = height - margin_bottom
    let axis_x1 = width - margin_right
    let axis_y1 = margin_top
    
    // Thicker axes (2px)
    draw_straight_line(img, axis_x0, axis_y0, axis_x0, axis_y1, 40, 40, 40, width, height)
    draw_straight_line(img, axis_x0 - 1, axis_y0, axis_x0 - 1, axis_y1, 40, 40, 40, width, height)
    draw_straight_line(img, axis_x0, axis_y0, axis_x1, axis_y0, 40, 40, 40, width, height)
    draw_straight_line(img, axis_x0, axis_y0 + 1, axis_x1, axis_y0 + 1, 40, 40, 40, width, height)
    
    // Grid lines with better visibility
    let grid_steps = 5
    let grid_i = 1
    while grid_i < grid_steps {
        let grid_y = axis_y0 - ((grid_i * chart_height) / grid_steps)
        draw_straight_line(img, axis_x0, grid_y, axis_x1, grid_y, 200, 200, 200, width, height)
        grid_i = grid_i + 1
    }
    
    // Vertical grid lines
    grid_i = 1
    while grid_i < 4 {
        let grid_x = axis_x0 + ((grid_i * chart_width) / 4)
        draw_straight_line(img, grid_x, axis_y0, grid_x, axis_y1, 230, 230, 230, width, height)
        grid_i = grid_i + 1
    }
    
    // Find min/max
    let min_val = data1[0]
    let max_val = data1[0]
    i = 0
    while i < len {
        if data1[i] < min_val { min_val = data1[i] }
        if data1[i] > max_val { max_val = data1[i] }
        if data2[i] < min_val { min_val = data2[i] }
        if data2[i] > max_val { max_val = data2[i] }
        i = i + 1
    }
    
    let range_val = max_val - min_val
    if range_val < 0.001 { range_val = 1.0 }
    min_val = min_val - (range_val * 0.1)
    max_val = max_val + (range_val * 0.1)
    range_val = max_val - min_val
    
    // Axis labels with better font
    draw_number(img, 20, axis_y0 - 3, 0, 60, 60, 60)
    draw_number(img, 20, axis_y1 - 3, 5, 60, 60, 60)
    draw_number(img, axis_x0 - 10, axis_y0 + 15, 0, 60, 60, 60)
    draw_number(img, axis_x1 - 5, axis_y0 + 15, len, 60, 60, 60)
    
    // Axis titles
    draw_text(img, 15, 20, 3, 40, 40, 40)  // "Loss"
    draw_text(img, width / 2 - 20, height - 20, 4, 40, 40, 40)  // "Epoch"
    
    // Draw markers first
    i = 0
    while i < len {
        let x = margin_left + ((i * chart_width) / (len - 1))
        
        let norm1 = (data1[i] - min_val) / range_val
        let y1 = axis_y0 - (norm1 * chart_height)
        if y1 < axis_y1 { y1 = axis_y1 }
        if y1 > axis_y0 { y1 = axis_y0 }
        draw_circle(img, x, y1, 4, 0, 70, 180)
        
        let norm2 = (data2[i] - min_val) / range_val
        let y2 = axis_y0 - (norm2 * chart_height)
        if y2 < axis_y1 { y2 = axis_y1 }
        if y2 > axis_y0 { y2 = axis_y0 }
        fill_rect(img, x - 3, y2 - 3, 7, 7, 220, 60, 0)
        
        i = i + 1
    }
    
    // Draw lines between markers (single pixel, stopping at marker edges)
    // Series 1 (blue)
    i = 0
    while i < (len - 1) {
        let x0 = margin_left + ((i * chart_width) / (len - 1))
        let norm0 = (data1[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        if y0 < axis_y1 { y0 = axis_y1 }
        if y0 > axis_y0 { y0 = axis_y0 }
        
        let x1 = margin_left + (((i + 1) * chart_width) / (len - 1))
        let norm1 = (data1[i + 1] - min_val) / range_val
        let y1 = axis_y0 - (norm1 * chart_height)
        if y1 < axis_y1 { y1 = axis_y1 }
        if y1 > axis_y0 { y1 = axis_y0 }
        
        draw_straight_line(img, x0, y0, x1, y1, 0, 100, 220, width, height)
        i = i + 1
    }
    
    // Series 2 (orange)
    i = 0
    while i < (len - 1) {
        let x0 = margin_left + ((i * chart_width) / (len - 1))
        let norm0 = (data2[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        if y0 < axis_y1 { y0 = axis_y1 }
        if y0 > axis_y0 { y0 = axis_y0 }
        
        let x1 = margin_left + (((i + 1) * chart_width) / (len - 1))
        let norm1 = (data2[i + 1] - min_val) / range_val
        let y1 = axis_y0 - (norm1 * chart_height)
        if y1 < axis_y1 { y1 = axis_y1 }
        if y1 > axis_y0 { y1 = axis_y0 }
        
        draw_straight_line(img, x0, y0, x1, y1, 255, 80, 0, width, height)
        i = i + 1
    }
    
    // Professional legend with shadow
    let leg_x = width - 200
    let leg_y = 30
    
    // Shadow
    fill_rect(img, leg_x + 3, leg_y + 3, 170, 70, 200, 200, 200)
    
    // White background
    fill_rect(img, leg_x, leg_y, 170, 70, 255, 255, 255)
    
    // Border (2px)
    fill_rect(img, leg_x, leg_y, 170, 2, 100, 100, 100)
    fill_rect(img, leg_x, leg_y + 68, 170, 2, 100, 100, 100)
    fill_rect(img, leg_x, leg_y, 2, 70, 100, 100, 100)
    fill_rect(img, leg_x + 168, leg_y, 2, 70, 100, 100, 100)
    
    // Legend items with better spacing
    draw_straight_line(img, leg_x + 15, leg_y + 25, leg_x + 50, leg_y + 25, 0, 100, 220, width, height)
    draw_circle(img, leg_x + 32, leg_y + 25, 4, 0, 70, 180)
    draw_text(img, leg_x + 60, leg_y + 18, 1, 40, 40, 40)  // "Train"
    
    draw_straight_line(img, leg_x + 15, leg_y + 50, leg_x + 50, leg_y + 50, 255, 80, 0, width, height)
    fill_rect(img, leg_x + 29, leg_y + 47, 7, 7, 220, 60, 0)
    draw_text(img, leg_x + 60, leg_y + 43, 2, 40, 40, 40)  // "Valid"
    
    return img
}

// ===== DEMO =====

print("Creating professional chart with:\n")
print("- Smooth Bezier curves (not jagged lines)\n")
print("- Better 5x7 pixel font\n")
print("- Improved color contrast\n")
print("- Grid lines (horizontal + vertical)\n")
print("- Drop shadow on legend\n")
print("- Thicker axes (2px)\n\n")

let train_loss = [2.5, 2.1, 1.8, 1.5, 1.3, 1.2, 1.1, 1.05, 1.02, 1.0, 0.98, 0.97, 0.96, 0.95]
let val_loss = [2.4, 2.0, 1.7, 1.5, 1.4, 1.3, 1.25, 1.22, 1.20, 1.19, 1.18, 1.17, 1.17, 1.16]
let epochs = 14

let chart = create_professional_chart(1000, 700, train_loss, val_loss, epochs)

if chart != nil {
    print("✓ Chart created successfully\n")
    let saved = image_save(chart, "professional_chart.png", "png")
    if saved {
        print("✓ Saved to professional_chart.png\n\n")
    }
    image_destroy(chart)
}

print("=== Professional Features ===\n")
print("✓ Smooth quadratic Bezier curves\n")
print("✓ 5x7 pixel font (clearer than 3x5)\n")
print("✓ Light gray background (better contrast)\n")
print("✓ White chart area with grid\n")
print("✓ Thicker axes (2px instead of 1px)\n")
print("✓ Vertical + horizontal grid lines\n")
