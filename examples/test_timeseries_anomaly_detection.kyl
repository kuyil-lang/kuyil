// Time Series Anomaly Detection and Alerting Engine
// Supports continuous and discrete data, multi-series correlation, anomaly masking

import("interfaces/interface_ds.kyl")

// ============================================
// Statistical Anomaly Detection
// ============================================

fn calculateStats(values) {
    // Calculate mean, stddev, min, max for a time window
    if values.length == 0 {
        return {"mean": 0, "stddev": 0, "min": 0, "max": 0}
    }
    
    let sum = 0
    let min = values[0]
    let max = values[0]
    let i = 0
    
    while i < values.length {
        sum = sum + values[i]
        if values[i] < min {
            min = values[i]
        }
        if values[i] > max {
            max = values[i]
        }
        i = i + 1
    }
    
    let mean = sum / values.length
    
    // Calculate standard deviation
    let sumSquaredDiff = 0
    i = 0
    while i < values.length {
        let diff = values[i] - mean
        sumSquaredDiff = sumSquaredDiff + (diff * diff)
        i = i + 1
    }
    
    let variance = sumSquaredDiff / values.length
    let stddev = variance  // Simplified: should be sqrt(variance)
    
    return {"mean": mean, "stddev": stddev, "min": min, "max": max}
}

fn detectThresholdAnomaly(value, threshold, operator) {
    // Simple threshold-based detection
    // operator: "gt" (>), "lt" (<), "gte" (>=), "lte" (<=)
    if operator == "gt" {
        return value > threshold
    }
    if operator == "lt" {
        return value < threshold
    }
    if operator == "gte" {
        return value >= threshold
    }
    if operator == "lte" {
        return value <= threshold
    }
    return false
}

fn detectStatisticalAnomaly(value, baseline, sensitivity) {
    // Z-score based detection
    // sensitivity: 2 = 95% confidence, 3 = 99.7% confidence
    let zscore = (value - baseline.mean) / baseline.stddev
    if zscore < 0 {
        zscore = -zscore
    }
    return zscore > sensitivity
}

fn detectRateOfChange(current, previous, maxChangePercent) {
    // Detect sudden spikes/drops
    if previous == 0 {
        return false
    }
    let change = ((current - previous) / previous) * 100
    if change < 0 {
        change = -change
    }
    return change > maxChangePercent
}

// ============================================
// Anomaly Masking (Suppression)
// ============================================

fn createAnomalyMask(maskDB, metric, tags, startTime, endTime, reason) {
    // Create a time-range mask to suppress alerts
    // Key: "mask:metric:tagString:startTime"
    let tagStr = ""
    let i = 0
    while i < tags.length {
        if i > 0 {
            tagStr = tagStr + ","
        }
        tagStr = tagStr + tags[i]
        i = i + 1
    }
    
    let maskKey = "mask:" + metric + ":" + tagStr + ":" + startTime
    let mask = {
        "metric": metric,
        "tags": tags,
        "startTime": startTime,
        "endTime": endTime,
        "reason": reason,
        "active": true
    }
    
    ds_concurrentHashMapPut(maskDB, maskKey, mask)
    return maskKey
}

fn isAnomalyMasked(maskDB, metric, tags, timestamp) {
    // Check if this time point is masked
    let tagStr = ""
    let i = 0
    while i < tags.length {
        if i > 0 {
            tagStr = tagStr + ","
        }
        tagStr = tagStr + tags[i]
        i = i + 1
    }
    
    // Query all masks for this metric+tags (simplified - in production use index)
    let maskPattern = "mask:" + metric + ":" + tagStr
    let keys = ds_concurrentHashMapKeys(maskDB)
    
    i = 0
    while i < keys.length {
        let key = keys[i]
        // Simple string prefix check (would use proper pattern matching in production)
        let mask = ds_concurrentHashMapGet(maskDB, key)
        if mask != nil and mask.active {
            if timestamp >= mask.startTime and timestamp <= mask.endTime {
                return true
            }
        }
        i = i + 1
    }
    
    return false
}

// ============================================
// Multi-Series Correlation Detection
// ============================================

fn detectCorrelatedAnomaly(alertDB, series1, series2, timestamp, correlation) {
    // Detect correlated changes across multiple series
    // Example: Traffic shift from region A to region B (sum stays constant)
    
    let series1Key = "value:" + series1.metric + ":" + series1.tags[0] + ":" + timestamp
    let series2Key = "value:" + series2.metric + ":" + series2.tags[0] + ":" + timestamp
    
    let val1 = ds_concurrentHashMapGet(alertDB, series1Key)
    let val2 = ds_concurrentHashMapGet(alertDB, series2Key)
    
    if val1 == nil or val2 == nil {
        return false
    }
    
    // Check if correlation type matches
    if correlation == "inverse" {
        // val1 up, val2 down (or vice versa) = expected behavior, not anomaly
        let delta1 = val1.current - val1.previous
        let delta2 = val2.current - val2.previous
        
        // If one goes up and other goes down by similar amount, suppress alert
        let bothDirections = (delta1 > 0 and delta2 < 0)
        let oppositeDirections = (delta1 < 0 and delta2 > 0)
        
        if bothDirections {
            let ratio = (delta1 + delta2) / delta1
            if ratio < 0.2 and ratio > -0.2 {
                // Changes cancel out - likely traffic shift, not anomaly
                return true
            }
        }
        
        if oppositeDirections {
            let ratio = (delta1 + delta2) / delta1
            if ratio < 0.2 and ratio > -0.2 {
                return true
            }
        }
    }
    
    if correlation == "sum_constant" {
        // Total across series should be constant
        let total = val1.current + val2.current
        let expectedTotal = val1.baseline + val2.baseline
        let deviation = (total - expectedTotal) / expectedTotal
        if deviation < 0 {
            deviation = -deviation
        }
        
        // If total is stable, individual changes are likely traffic shifts
        return deviation < 0.1  // Within 10% of expected
    }
    
    return false
}

// ============================================
// Alert Rule Engine
// ============================================

fn createAlertRule(ruleDB, ruleId, config) {
    // Create an alert rule
    // config: {metric, tags, type, threshold, sensitivity, duration, severity}
    ds_concurrentHashMapPut(ruleDB, ruleId, config)
    return ruleId
}

fn evaluateAlertRules(ruleDB, maskDB, alertDB, metric, tags, timestamp, value, baseline) {
    // Evaluate all rules for this metric
    let alerts = []
    let keys = ds_concurrentHashMapKeys(ruleDB)
    
    let i = 0
    while i < keys.length {
        let ruleId = keys[i]
        let rule = ds_concurrentHashMapGet(ruleDB, ruleId)
        
        if rule != nil and rule.metric == metric {
            // Check if masked
            if isAnomalyMasked(maskDB, metric, tags, timestamp) {
                i = i + 1
            } else {
                let isAnomaly = false
                
                if rule.type == "threshold" {
                    isAnomaly = detectThresholdAnomaly(value, rule.threshold, rule.operator)
                }
                
                if rule.type == "statistical" {
                    isAnomaly = detectStatisticalAnomaly(value, baseline, rule.sensitivity)
                }
                
                if rule.type == "rate_of_change" {
                    if baseline.previous != nil {
                        isAnomaly = detectRateOfChange(value, baseline.previous, rule.maxChangePercent)
                    }
                }
                
                if isAnomaly {
                    let alert = {
                        "ruleId": ruleId,
                        "metric": metric,
                        "tags": tags,
                        "timestamp": timestamp,
                        "value": value,
                        "severity": rule.severity,
                        "message": rule.message
                    }
                    alerts = alerts + [alert]
                }
                
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    
    return alerts
}

