    "sensitivity": 3.0,
    "severity": "warning",
    "message": "Response time anomaly detected"
}

createAlertRule(ruleDB, "rule3", rule3Config)
print("✓ Created rule: Response time Z-score > 3\n")

// Simulate baseline calculation
let historicalValues = [120, 125, 118, 130, 122, 128, 115, 135]
let baseline = calculateStats(historicalValues)
print("Baseline stats:")
print("  Mean: " + baseline.mean + " ms")
print("  StdDev: " + baseline.stddev)
print("  Range: " + baseline.min + " - " + baseline.max + " ms\n")

// Test anomaly detection
let testValues = [125, 128, 250, 130]  // 250 is anomaly
print("Testing values against baseline:")
let i = 0
while i < testValues.length {
    let val = testValues[i]
    let isAnom = detectStatisticalAnomaly(val, baseline, 3.0)
    let status = "✓ Normal"
    if isAnom {
        status = "⚠ ANOMALY"
    }
    print("  " + val + " ms: " + status)
    i = i + 1
}
print("")

// Demo 3: Anomaly Masking (Suppression)
print("Demo 3: Anomaly Masking\n")
print("------------------------")

let tags1 = ["host=server1", "region=us-east"]
let currentTime = 1700388000

// Create maintenance window mask
let maskKey = createAnomalyMask(
    maskDB,
    "cpu.usage",
    tags1,
    currentTime,
    currentTime + 3600,
    "Scheduled maintenance window"
)

print("✓ Created anomaly mask:")
print("  Metric: cpu.usage")
print("  Time range: " + currentTime + " to " + (currentTime + 3600))
print("  Reason: Scheduled maintenance window\n")

// Test if timestamp is masked
let testTime1 = currentTime + 1800  // Inside window
let testTime2 = currentTime + 5000  // Outside window

let masked1 = isAnomalyMasked(maskDB, "cpu.usage", tags1, testTime1)
let masked2 = isAnomalyMasked(maskDB, "cpu.usage", tags1, testTime2)

print("Timestamp checks:")
print("  t+" + (testTime1 - currentTime) + "s: Masked = " + masked1 + " ✓")
print("  t+" + (testTime2 - currentTime) + "s: Masked = " + masked2 + " ✓")
print("")

// Demo 4: Multi-Series Correlation
print("Demo 4: Multi-Series Correlation Detection\n")
print("-------------------------------------------")

print("Scenario: Traffic shift between regions\n")

// Simulate region values
let usEastPrev = 1500
let usEastCurr = 1000
let usWestPrev = 1500
let usWestCurr = 2000

print("Region values:")
print("  us-east: " + usEastPrev + " -> " + usEastCurr + " (↓" + (usEastPrev - usEastCurr) + ")")
print("  us-west: " + usWestPrev + " -> " + usWestCurr + " (↑" + (usWestCurr - usWestPrev) + ")")
print("")

// Check if changes cancel out (traffic shift vs real anomaly)
let delta1 = usEastCurr - usEastPrev
let delta2 = usWestCurr - usWestPrev
let totalChange = delta1 + delta2

print("Correlation analysis:")
print("  East delta: " + delta1)
print("  West delta: " + delta2)
print("  Total change: " + totalChange)
print("")

let isTrafficShift = false
if (delta1 < 0 and delta2 > 0) {
    // One down, one up
    let ratio = (delta1 + delta2) / delta1
    if ratio < 0.2 and ratio > -0.2 {
        isTrafficShift = true
    }
}

if isTrafficShift {
    print("✓ Detected correlated traffic shift (alert suppressed)")
} else {
    print("⚠ Real anomaly detected (alert triggered)")
}
print("")

