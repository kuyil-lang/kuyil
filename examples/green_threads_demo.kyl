// 2. Basic Task Simulation
print("2. Task Execution Simulation:")
print("")

print("[TASK-1] Starting CPU computation task")
let cpu_result = 100 + 50
print("[TASK-1] Computation completed: " + toString(cpu_result))

print("[TASK-2] Starting I/O simulation task")  
let io_result = 200 + 75
print("[TASK-2] I/O operation completed: " + toString(io_result))

print("[TASK-3] Starting data processing task")
let data_result = 300 + 25
print("[TASK-3] Data processing completed: " + toString(data_result))

print("")

// 3. Task States and Lifecycle
print("3. Task State Management:")
print("")

let task_id = 1001
print("[STATE] Task " + toString(task_id) + " created")
print("[STATE] Task " + toString(task_id) + " started")
print("[STATE] Task " + toString(task_id) + " running")
print("[STATE] Task " + toString(task_id) + " completed")

print("")

// 4. Error Handling
print("4. Task Error Handling:")
print("")

let error_task = 2001  
print("[ERROR] Task " + toString(error_task) + " encountered error")
print("[RETRY] Implementing retry mechanism")
print("[SUCCESS] Task " + toString(error_task) + " completed on retry")

print("")

// 5. Resource Management
print("5. Resource Management:")
print("")

let active_tasks = 3
let max_tasks = 10
let available_slots = max_tasks - active_tasks

print("[RESOURCES] Active tasks: " + toString(active_tasks))
print("[RESOURCES] Maximum tasks: " + toString(max_tasks))  
print("[RESOURCES] Available slots: " + toString(available_slots))

print("")

// 6. Future API Reference
print("6. Green Threads API Reference:")
print("")

print("[API] start_bg(function_name, arg1, arg2, ...) -> task_handle")
print("[API] wait_bg(task_handle) -> result")
print("[API] kill_bg(task_handle) -> success")
print("[API] list_bg() -> [active_handles]")
print("[API] task_status(handle) -> 'running'|'completed'|'failed'")

print("")

// 7. Usage Patterns
print("7. Common Usage Patterns:")
print("")

print("[PATTERN] Producer-Consumer:")
print("  producer = start_bg('generate_data', 1000)")
print("  consumer = start_bg('process_data', queue)")
print("  wait_bg(consumer)")

print("")
print("[PATTERN] Worker Pool:")
print("  workers = []")
print("  for i in 1..5:")
print("    workers.push(start_bg('worker_task', i))")
print("  results = workers.map(wait_bg)")

print("")
print("[PATTERN] Timeout Handling:")
print("  task = start_bg('long_operation')")
print("  if !wait_bg_timeout(task, 5000):")
print("    kill_bg(task)")

print("")
