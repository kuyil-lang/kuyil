print("Demo 10: Building a Dashboard\n")
print("------------------------------")

print("Complete dashboard with multiple chart types...")
print("")
print("Dashboard layout:")
print("  1. Top row: Line chart (trends over time)")
print("  2. Middle left: Bar chart (category comparison)")
print("  3. Middle right: Pie chart (distribution)")
