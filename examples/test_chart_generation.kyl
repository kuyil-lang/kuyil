print("  let chart4 = chart_create_scatter(800, 400)")
print("")
print("  // Configure and populate each chart")
print("  // ... (add data and styling)")
print("")
print("  // Export all charts")
print("  chart_render_png(chart1, \"dash_trends.png\")")
print("  chart_render_png(chart2, \"dash_bars.png\")")
print("  chart_render_png(chart3, \"dash_pie.png\")")
print("  chart_render_png(chart4, \"dash_scatter.png\")")
print("")
print("  // Cleanup")
print("  chart_destroy(chart1)")
print("  chart_destroy(chart2)")
print("  chart_destroy(chart3)")
print("  chart_destroy(chart4)")
print("")

print("✓ Dashboard example shown\n")

// ============================================
// Best Practices
// ============================================

print("=== Best Practices for Chart Generation ===\n")

print("1. Chart Selection:")
print("   - Line: Time series, trends, continuous data")
print("   - Bar: Comparisons, categories, discrete data")
print("   - Pie: Proportions, percentages (limit to 5-7 slices)")
print("   - Scatter: Correlations, distributions, relationships")
print("   - Histogram: Frequency distributions, data spread\n")

print("2. Color Guidelines:")
print("   - Use color-blind friendly palettes")
print("   - Limit to 3-5 colors per chart")
print("   - Use contrast for readability")
print("   - Consistent colors across dashboard")
print("   - Hex colors: #RRGGBB format\n")

print("3. Readability:")
print("   - Clear, descriptive titles")
print("   - Label axes with units")
print("   - Add grid lines for precision")
print("   - Use legends for multi-series")
print("   - Font size: title 14-16, labels 10-12\n")

print("4. Data Density:")
print("   - Don't overcrowd charts (max 5-7 series)")
print("   - Aggregate data when needed")
print("   - Use drill-down for details")
print("   - Split complex charts into multiple views\n")

print("5. Chart Sizing:")
print("   - Web: 800x600 or 1000x600 (standard)")
print("   - Mobile: 400x300 (responsive)")
print("   - Print: 1200x900 or higher (300 DPI)")
print("   - Thumbnail: 200x150 (preview)\n")

print("6. Performance:")
print("   - Limit data points (downsample if needed)")
print("   - Cache generated charts")
print("   - Use appropriate format (PNG for web, PDF for print)")
print("   - Generate charts asynchronously for dashboards\n")

print("7. Accessibility:")
print("   - Add alt text descriptions")
print("   - Use patterns in addition to colors")
print("   - Ensure sufficient contrast")
print("   - Provide data table alternative\n")

print("8. Common Mistakes to Avoid:")
print("   - Don't use 3D effects (distorts data)")
print("   - Don't truncate Y-axis (misleading)")
print("   - Don't use too many pie slices (>7)")
print("   - Don't mix incompatible scales")
print("   - Don't use distracting animations\n")

print("9. Chart Styling Tips:")
print("   - Minimize chart junk (borders, backgrounds)")
print("   - Use whitespace effectively")
print("   - Align titles and labels")
print("   - Consistent font family")
print("   - Professional color palette\n")

print("10. Integration Patterns:")
print("    - Generate charts from database queries")
print("    - Update charts with real-time data")
print("    - Embed charts in reports (PDF)")
print("    - Create interactive dashboards (SVG)")
print("    - Export for presentations (PNG)\n")

print("✓ Chart generation demo complete\n")
