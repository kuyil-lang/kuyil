// SQLite Interface Demo
import "sqlite"

print("=== SQLite Demo ===")
// 0 = default flags (library will interpret as read/write create if supported)
let db = kyl_sqlite_open_database("examples/demo.db", 0)
if (db) {
  print("Opened DB")
  kyl_sqlite_execute_sql(db, "DROP TABLE IF EXISTS t;")
  kyl_sqlite_execute_sql(db, "CREATE TABLE t (x INT);")
  kyl_sqlite_execute_sql(db, "INSERT INTO t(x) VALUES (42);")
  print("Inserted row.")
  kyl_sqlite_close_database(db)
} else {
  print("Failed to open DB")
}
