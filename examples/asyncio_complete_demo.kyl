// Complete example with inline wrapper functions
loadlib("libs/libkylasyncio.so")

print("\n═══════════════════════════════════════")
print("  Asyncio HTTP with Headers & Timeouts")
print("═══════════════════════════════════════\n")

// Example 1: Simple GET
print("1. Simple GET:")
let req1 = kyl_asyncio_httpGet("https://httpbin.org/get")
print("   Request ID: " + req1)

// Example 2: GET with custom headers and timeouts
print("\n2. GET with headers and timeouts:")
let headers2 = [
  "User-Agent: Kuyil/1.0",
  "Accept: application/json",
  "X-Custom-Header: test-value"
]
// Parameters: url, headers, dns_timeout, connect_timeout, read_timeout, write_timeout (in ms)
let req2 = kyl_asyncio_httpGetEx("https://httpbin.org/headers", headers2, 30, 500, 2000, 500)
print("   Request ID: " + req2)
print("   Headers: User-Agent, Accept, X-Custom-Header")
print("   Timeouts: dns=30ms, connect=500ms, read=2000ms, write=500ms")

// Example 3: POST with headers
print("\n3. POST with JSON body and headers:")
let postHeaders = [
  "Content-Type: application/json",
  "Accept: application/json"
]
let postBody = '{"name": "Kuyil", "version": "1.0", "features": ["async", "http"]}'
let req3 = kyl_asyncio_httpPostEx("https://httpbin.org/post", postBody, postHeaders, 0, 1000, 3000, 500)
print("   Request ID: " + req3)
print("   Headers: Content-Type, Accept")
print("   Timeouts: connect=1000ms, read=3000ms, write=500ms")

// Example 4: Check completion status
print("\n4. Checking completion status (non-blocking):")
print("   Request 1 complete: " + kyl_asyncio_isComplete(req1))
print("   Request 2 complete: " + kyl_asyncio_isComplete(req2))
print("   Request 3 complete: " + kyl_asyncio_isComplete(req3))

print("\n✓ All requests submitted successfully!")
print("\n📝 API Usage:")
print("   - kyl_asyncio_httpGet(url) -> requestId")
print("   - kyl_asyncio_httpGetEx(url, headers, dns_ms, connect_ms, read_ms, write_ms) -> requestId")
print("   - kyl_asyncio_httpPost(url, body) -> requestId") 
print("   - kyl_asyncio_httpPostEx(url, body, headers, dns_ms, connect_ms, read_ms, write_ms) -> requestId")
print("   - kyl_asyncio_waitResult(requestId, timeout_ms) -> data")
print("   - kyl_asyncio_isComplete(requestId) -> bool")
print("   - kyl_asyncio_getResult(requestId) -> data or nil")
