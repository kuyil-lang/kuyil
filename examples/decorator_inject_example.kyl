// Decorator Syntax Demo - @inject Parameter Decorators
// This demonstrates @inject decorator syntax (runtime behavior planned for future)

print("===========================================================")
print("    @inject Decorator - Syntax Demo (Parser Support)      ")
print("===========================================================")
print("")
print("Note: @inject runtime behavior is not yet implemented.")
print("This demo shows that parameter decorators are parsed correctly.")
print("")

// ============================================================================
// Example 1: Single @inject Parameter
// ============================================================================
print("Example 1: Single @inject Parameter")
print("-----------------------------------------------------------")

fn createUser(@inject db, username, email) {
    print("  Function: createUser")
    print("  Parameters: db (injected), username, email")
    return "User " + username + " created"
}

print("\nChecking parameter decorators:")
let params1 = @get("createUser", "params")
print("createUser parameter decorators:")
print(params1)
print("")

// ============================================================================
// Example 2: Multiple @inject Parameters
// ============================================================================
print("Example 2: Multiple @inject Parameters")
print("-----------------------------------------------------------")

fn processOrder(@inject db, @inject logger, orderId, amount) {
    print("  Function: processOrder")
    print("  Parameters: db (injected), logger (injected), orderId, amount")
    return "Order " + orderId + " processed"
}

print("\nChecking parameter decorators:")
let params2 = @get("processOrder", "params")
print("processOrder parameter decorators:")
print(params2)
print("")

// ============================================================================
// Example 3: Mixed Parameter Decorators
// ============================================================================
print("Example 3: Mixed Parameter Decorators")
print("-----------------------------------------------------------")

fn updateUser(@inject db, @validate userId, @validate email) {
    print("  Function: updateUser")
    print("  Parameters: db (injected), userId (validated), email (validated)")
    return "User updated"
}

print("\nChecking parameter decorators:")
let params3 = @get("updateUser", "params")
print("updateUser parameter decorators:")
print(params3)
print("")

// ============================================================================
// Example 4: Method with @inject
// ============================================================================
print("Example 4: Method Parameter Decorators")
print("-----------------------------------------------------------")

fn UserService_create(@inject db, @inject logger, userData) {
    print("  Method: UserService.create")
    print("  Parameters: db (injected), logger (injected), userData")
    return "Service method with injection"
}

print("\nChecking parameter decorators:")
let params4 = @get("UserService_create", "params")
print("UserService_create parameter decorators:")
print(params4)
print("")

// ============================================================================
// Summary
// ============================================================================
print("===========================================================")
print("Summary:")
print("-----------------------------------------------------------")
print("✓ @inject parameter decorator syntax works")
print("✓ Parser correctly handles parameter decorators")
print("✓ @get() can retrieve parameter decorator metadata")
print("✓ Multiple decorators per parameter supported")
print("")
print("Future: Runtime @inject will automatically inject dependencies")
print("from the dependency registry when functions are called.")
print("===========================================================")
