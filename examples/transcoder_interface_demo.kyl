// Transcoder/Compression Interface Demo
import("../interfaces/interface_transcoder.kyl")
import("../interfaces/interface_str.kyl")

print("=== Transcoder (Compression) Demo ===")

let input = "The quick brown fox jumps over the lazy dog"

print("Original: ", input)

// Compress using gzip (now returns object {data, length})
let gz = compressGzip(input)
print("Gzip compressed bytes: ", gz.length)

// Decompress using gzip (accepts the object)
let out = decompressGzip(gz)
print("Roundtrip ok: ", out == input)

