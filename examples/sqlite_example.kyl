// SQLite Database Usage Example
// Demonstrates basic database operations with SQLite

import("../interfaces/interface_sqlite.kyl") as db

print("=== SQLite Database Example ===")
print("")

// Database file path
let dbPath = "example.db"

// Open flags: SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE = 6
let openFlags = 6

print("Opening database:", dbPath)
let handle = db.openDatabase(dbPath, openFlags)

if (handle < 0) {
    print("Error: Failed to open database")
} else {
    print("Database opened successfully, handle:", handle)
    print("")
    
    // Create table
    print("Creating users table...")
    let createTableSQL = "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT, email TEXT, age INTEGER)"
    let result = db.executeSql(handle, createTableSQL)
    print("Create table result:", result)
    print("")
    
    // Insert data
    print("Inserting sample data...")
    let insert1 = "INSERT INTO users (name, email, age) VALUES ('Alice Johnson', 'alice@example.com', 30)"
    let insert2 = "INSERT INTO users (name, email, age) VALUES ('Bob Smith', 'bob@example.com', 25)"
    let insert3 = "INSERT INTO users (name, email, age) VALUES ('Carol White', 'carol@example.com', 35)"
    
    db.executeSql(handle, insert1)
    db.executeSql(handle, insert2)
    db.executeSql(handle, insert3)
    print("Data inserted successfully")
    print("")
    
    // Query data
    print("Querying all users...")
    let querySQL = "SELECT * FROM users"
    let queryResult = db.executeQuery(handle, querySQL)
    print("Query executed, result:", queryResult)
    print("")
    
    // Update data
    print("Updating user age...")
    let updateSQL = "UPDATE users SET age = 31 WHERE name = 'Alice Johnson'"
    db.executeSql(handle, updateSQL)
    print("Update completed")
    print("")
    
    // Delete data
    print("Deleting user...")
    let deleteSQL = "DELETE FROM users WHERE name = 'Bob Smith'"
    db.executeSql(handle, deleteSQL)
    print("Delete completed")
    print("")
    
    // Query count
    print("Counting remaining users...")
    let countSQL = "SELECT COUNT(*) FROM users"
    db.executeQuery(handle, countSQL)
    print("")
    
    // Close database
    print("Closing database...")
    let closeResult = db.closeDatabase(handle)
    print("Database closed, result:", closeResult)
}

print("")
print("=== SQLite Operations Complete ===")
print("Database file:", dbPath)
print("You can inspect the database with: sqlite3 example.db")
