// Working @wrap() Decorator Example

print("╔═══════════════════════════════════════════════════════════╗")
print("║         @wrap() Decorator - Working Example              ║")
print("╚═══════════════════════════════════════════════════════════╝")
print("")

// Example 1: Simple logging wrapper
print("Example 1: Logging Wrapper")
print("───────────────────────────────────────────────────────────")

fn loggingWrapper(originalFunc, args) {
    print("  [LOG] Function called")
    print("  [LOG] Calling original function...")
    
    // Call original function with first argument
    let result = originalFunc(args[0])
    
    print("  [LOG] Function completed")
    return result
}

@wrap(handler=loggingWrapper)
fn addTen(x) {
    print("    → Inside addTen: calculating " + x + " + 10")
    return x + 10
}

print("Test: addTen(5)")
let result1 = addTen(5)
print("Result: " + result1)
print("")

// Example 2: Performance timing
print("Example 2: Timing Wrapper")
print("───────────────────────────────────────────────────────────")

fn timingWrapper(originalFunc, args) {
    print("  [TIMER] Start")
    let result = originalFunc(args[0])
    print("  [TIMER] End")
    return result
}

@wrap(handler=timingWrapper)
fn processData(data) {
    print("    → Processing: " + data)
    return "Result: " + data
}

print("Test: processData('test')")
let result2 = processData("test")
print("Result: " + result2)
print("")

// Example 3: Authorization check
print("Example 3: Authorization Wrapper")
print("───────────────────────────────────────────────────────────")

fn authWrapper(originalFunc, args) {
    print("  [AUTH] Checking permissions...")
    print("  [AUTH] Access granted")
    return originalFunc(args[0])
}

@wrap(handler=authWrapper)
fn deleteRecord(id) {
    print("    → Deleting record: " + id)
    return "Deleted: " + id
}

print("Test: deleteRecord('record_123')")
let result3 = deleteRecord("record_123")
print("Result: " + result3)
print("")

// Example 4: Caching wrapper
print("Example 4: Caching Wrapper")
print("───────────────────────────────────────────────────────────")

fn cachingWrapper(originalFunc, args) {
    print("  [CACHE] Checking cache...")
    print("  [CACHE] Cache miss - calling function")
    let result = originalFunc(args[0])
    print("  [CACHE] Storing in cache")
    return result
}

@wrap(handler=cachingWrapper)
fn fetchUser(userId) {
    print("    → Fetching user from DB: " + userId)
    return "User{id=" + userId + ",name=John}"
}

print("Test: fetchUser('42')")
let result4 = fetchUser("42")
print("Result: " + result4)
print("")

// Example 5: Error handling
print("Example 5: Error Handling Wrapper")
print("───────────────────────────────────────────────────────────")

fn errorHandlingWrapper(originalFunc, args) {
    print("  [ERROR_HANDLER] Try block")
    let result = originalFunc(args[0])
    print("  [ERROR_HANDLER] Success")
    return result
}

@wrap(handler=errorHandlingWrapper)
fn riskyFunction(value) {
    print("    → Executing risky operation: " + value)
    return "Safe result: " + value
}

print("Test: riskyFunction('data')")
let result5 = riskyFunction("data")
print("Result: " + result5)
print("")

// Verify decorators are registered
print("Verification: Check decorator metadata")
print("───────────────────────────────────────────────────────────")
let decs = @get("addTen")
print("addTen decorators:")
print(decs)
print("")

print("╔═══════════════════════════════════════════════════════════╗")
print("║                      SUMMARY                              ║")
print("╚═══════════════════════════════════════════════════════════╝")
print("")
print("✓ @wrap() decorator successfully intercepts function calls")
print("✓ Handler functions receive original function and arguments")
print("✓ Handlers can execute logic before and after the call")
print("✓ Demonstrated: logging, timing, auth, caching, error handling")
print("")
print("🎉 @wrap() runtime behavior is fully operational!")
