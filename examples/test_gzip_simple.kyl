// Test gzip with byte array object return
import("../interfaces/interface_str.kyl")
import("../interfaces/interface_transcoder.kyl")

let original = "Hello World! This is a test of gzip compression with byte arrays."
print("Original: " + original + "\n")

// Compress - returns object with {data: [bytes...], length: N}
print("Compressing...\n")
let compressed = compressGzip(original)
print("Compressed length: ")
print(compressed.length)
print("\n")

// Decompress - takes object with {data: [bytes...], length: N}
print("Decompressing...\n")
let decompressed = decompressGzip(compressed)
print("Decompressed: " + decompressed + "\n")

// Check roundtrip
print("Roundtrip match: ")
print(original == decompressed)
print("\n")
