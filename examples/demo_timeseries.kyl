// Time Series Chart Demo with Real Rendering
import "image"

print("=== Time Series Chart Demo ===\n\n")

// ===== Chart Rendering Functions =====

// Helper: Draw a line using Bresenham's algorithm
fn draw_line(img, x0, y0, x1, y1, r, g, b) {
    let dx = x1 - x0
    if dx < 0 {
        dx = 0 - dx
    }
    
    let dy = y1 - y0
    if dy < 0 {
        dy = 0 - dy
    }
    
    let sx = 1
    if x0 > x1 {
        sx = 0 - 1
    }
    
    let sy = 1
    if y0 > y1 {
        sy = 0 - 1
    }
    
    let err = dx - dy
    let x = x0
    let y = y0
    
    let max_steps = dx + dy + 10
    let steps = 0
    
    while steps < max_steps {
        image_set_pixel(img, x, y, r, g, b, 255)
        
        if x == x1 {
            if y == y1 {
                steps = max_steps
            }
        }
        
        let e2 = 2 * err
        if e2 > (0 - dy) {
            err = err - dy
            x = x + sx
        }
        if e2 < dx {
            err = err + dx
            y = y + sy
        }
        
        steps = steps + 1
    }
}

// Helper: Fill rectangle
fn fill_rect(img, x, y, w, h, r, g, b) {
    let i = 0
    while i < w {
        let j = 0
        while j < h {
            let px = x + i
            let py = y + j
            image_set_pixel(img, px, py, r, g, b, 255)
            j = j + 1
        }
        i = i + 1
    }
}

// Create line chart from time series data
fn create_line_chart(width, height, data, data_len, title) {
    // Create image with white background
    let img = image_create(width, height, 3)
    
    // Fill white background
    let i = 0
    while i < width {
        let j = 0
        while j < height {
            image_set_pixel(img, i, j, 255, 255, 255, 255)
            j = j + 1
        }
        i = i + 1
    }
    
    // Chart margins
    let margin_left = 60
    let margin_right = 20
    let margin_top = 40
    let margin_bottom = 40
    
    let chart_width = width - margin_left - margin_right
    let chart_height = height - margin_top - margin_bottom
    
    // Draw axes
    let axis_x0 = margin_left
    let axis_y0 = height - margin_bottom
    let axis_x1 = width - margin_right
    let axis_y1 = margin_top
    
    // Y-axis
    draw_line(img, axis_x0, axis_y0, axis_x0, axis_y1, 0, 0, 0)
    // X-axis
    draw_line(img, axis_x0, axis_y0, axis_x1, axis_y0, 0, 0, 0)
    
    // Find data min/max
    let min_val = data[0]
    let max_val = data[0]
    i = 1
    while i < data_len {
        if data[i] < min_val {
            min_val = data[i]
        }
        if data[i] > max_val {
            max_val = data[i]
        }
        i = i + 1
    }
    
    // Add some padding to range
    let range_val = max_val - min_val
    if range_val < 0.001 {
        range_val = 1.0
    }
    min_val = min_val - (range_val * 0.1)
    max_val = max_val + (range_val * 0.1)
    range_val = max_val - min_val
    
    // Draw data points and lines
    i = 0
    while i < (data_len - 1) {
        // Calculate pixel positions
        let x0 = margin_left + ((i * chart_width) / (data_len - 1))
        let norm0 = (data[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        
        let x1 = margin_left + (((i + 1) * chart_width) / (data_len - 1))
        let norm1 = (data[i + 1] - min_val) / range_val
        let y1 = axis_y0 - (norm1 * chart_height)
        
        // Draw line segment (blue)
        draw_line(img, x0, y0, x1, y1, 0, 100, 200)
        
        // Draw point marker (darker blue)
        fill_rect(img, x0 - 2, y0 - 2, 4, 4, 0, 50, 150)
        
        i = i + 1
    }
    
    // Draw last point
    let x_last = margin_left + (((data_len - 1) * chart_width) / (data_len - 1))
    let norm_last = (data[data_len - 1] - min_val) / range_val
    let y_last = axis_y0 - (norm_last * chart_height)
    fill_rect(img, x_last - 2, y_last - 2, 4, 4, 0, 50, 150)
    
    return img
}

// Create bar chart
fn create_bar_chart(width, height, data, data_len, title) {
    let img = image_create(width, height, 3)
    
    // White background
    let i = 0
    while i < width {
        let j = 0
        while j < height {
            image_set_pixel(img, i, j, 255, 255, 255, 255)
            j = j + 1
        }
        i = i + 1
    }
    
    // Margins
    let margin_left = 60
    let margin_right = 20
    let margin_top = 40
    let margin_bottom = 40
    
    let chart_width = width - margin_left - margin_right
    let chart_height = height - margin_top - margin_bottom
    
    // Draw axes
    let axis_x0 = margin_left
    let axis_y0 = height - margin_bottom
    let axis_x1 = width - margin_right
    let axis_y1 = margin_top
    
    draw_line(img, axis_x0, axis_y0, axis_x0, axis_y1, 0, 0, 0)
    draw_line(img, axis_x0, axis_y0, axis_x1, axis_y0, 0, 0, 0)
    
    // Find max value
    let max_val = data[0]
    i = 1
    while i < data_len {
        if data[i] > max_val {
            max_val = data[i]
        }
        i = i + 1
    }
    
    if max_val < 0.001 {
        max_val = 1.0
    }
    
    // Draw bars
    let bar_width = chart_width / data_len
    let bar_spacing = bar_width / 5
    let actual_bar_width = bar_width - bar_spacing
    
    i = 0
    while i < data_len {
        let bar_height = (data[i] / max_val) * chart_height
        let bar_x = margin_left + (i * bar_width) + (bar_spacing / 2)
        let bar_y = axis_y0 - bar_height
        
        // Alternate colors for bars
        let bar_r = 70
        let bar_g = 130
        let bar_b = 180
        
        let remainder = i % 3
        if remainder == 1 {
            bar_r = 200
            bar_g = 100
            bar_b = 80
        }
        if remainder == 2 {
            bar_r = 100
            bar_g = 180
            bar_b = 100
        }
        
        fill_rect(img, bar_x, bar_y, actual_bar_width, bar_height, bar_r, bar_g, bar_b)
        
        i = i + 1
    }
    
    return img
}

// ===== Demo Start =====

// Demo 1: Simple sine wave time series
print("Demo 1: Sine Wave Time Series\n")
print("------------------------------\n")

// Generate sine wave data
let data1 = [0.0, 0.5, 0.87, 1.0, 0.87, 0.5, 0.0, -0.5, -0.87, -1.0, -0.87, -0.5, 0.0, 0.5, 0.87, 1.0]
let len1 = 16

print("Generated ", len1, " data points (sine wave)\n")

let chart1 = create_line_chart(800, 400, data1, len1, "Sine Wave")
if chart1 != nil {
    print("✓ Created line chart\n")
    let saved1 = image_save(chart1, "timeseries_sine.png", "png")
    if saved1 {
        print("✓ Saved to timeseries_sine.png\n")
    }
    image_destroy(chart1)
}

print("\n")

