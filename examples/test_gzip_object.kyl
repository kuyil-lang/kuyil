// Test gzip with byte array object return
@loadlib("str")
@loadlib("transcoder")

let original = "Hello World! This is a test of gzip compression with byte arrays."
print("Original: ")
print(original)
print("\nOriginal length: ")
print(str_length(original))

// Compress - returns object with {data: [bytes...], length: N}
print("\n\nCompressing...")
let compressed = gzip_compress(original)
print("\nCompressed type: ")
print(type_of(compressed))
print("\nCompressed length: ")
print(compressed.length)
print("\nData array length: ")
print(array_length(compressed.data))

// Decompress - takes object with {data: [bytes...], length: N}
print("\n\nDecompressing...")
let decompressed = gzip_decompress(compressed)
print("\nDecompressed: ")
print(decompressed)
print("\nDecompressed length: ")
print(str_length(decompressed))

// Check roundtrip
print("\n\nRoundtrip match: ")
print(original == decompressed)
print("\n")
