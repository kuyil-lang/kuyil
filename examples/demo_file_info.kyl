// Comprehensive File Info Demo
// Shows all features of the new file_info() and str_bytesToString() API

import "interfaces/interface_fileio.kyl"
import "interfaces/interface_str.kyl"

print("╔════════════════════════════════════════════════════════╗")
print("║      Kuyil File Info API - Comprehensive Demo         ║")
print("╚════════════════════════════════════════════════════════╝\n")

// Test 1: HTML File
print("📄 HTML File Information")
print("─────────────────────────────────────────────────────────")
let htmlInfo = file_info("examples/webview_dist/index.html")
if htmlInfo != nil {
    print("  Path:          " + htmlInfo.path)
    print("  Size:          " + str_toString(htmlInfo.size) + " bytes")
    print("  Content-Type:  " + htmlInfo.contentType)
    print("  Modified:      " + str_toString(htmlInfo.modifiedTime))
    print("  Readable:      " + str_toString(htmlInfo.readable))
    print("  Writable:      " + str_toString(htmlInfo.writable))
    print("  Data bytes:    " + str_toString(htmlInfo.data.length))
    
    let htmlContent = str_bytesToString(htmlInfo.data)
    print("\n  Preview (first 100 chars):")
    print("  " + str.substring(htmlContent, 0, 100) + "...")
}
print("")

// Test 2: CSS File
print("🎨 CSS File Information")
print("─────────────────────────────────────────────────────────")
let cssInfo = file_info("examples/webview_dist/style.css")
if cssInfo != nil {
    print("  Size:          " + str_toString(cssInfo.size) + " bytes")
    print("  Content-Type:  " + cssInfo.contentType)
    
    let cssContent = str_bytesToString(cssInfo.data)
    print("\n  Preview (first 100 chars):")
    print("  " + str.substring(cssContent, 0, 100) + "...")
}
print("")

// Test 3: JavaScript File
print("📜 JavaScript File Information")
print("─────────────────────────────────────────────────────────")
let jsInfo = file_info("examples/webview_dist/app.js")
if jsInfo != nil {
    print("  Size:          " + str_toString(jsInfo.size) + " bytes")
    print("  Content-Type:  " + jsInfo.contentType)
    
    let jsContent = str_bytesToString(jsInfo.data)
    print("\n  Preview (first 100 chars):")
    print("  " + str.substring(jsContent, 0, 100) + "...")
}
print("")

// Test 4: Non-existent file
print("❌ Error Handling Test")
print("─────────────────────────────────────────────────────────")
let badInfo = file_info("nonexistent.txt")
if badInfo == nil {
    print("  ✓ Correctly returns nil for missing file")
}
print("")

// Test 5: Byte Array Inspection
print("🔍 Raw Byte Data Inspection")
print("─────────────────────────────────────────────────────────")
print("  First 10 bytes of HTML file:")
print("  [" + str_toString(htmlInfo.data[0]) + ", " + str_toString(htmlInfo.data[1]) + ", " + str_toString(htmlInfo.data[2]) + ", " + str_toString(htmlInfo.data[3]) + ", " + str_toString(htmlInfo.data[4]) + ", " + str_toString(htmlInfo.data[5]) + ", " + str_toString(htmlInfo.data[6]) + ", " + str_toString(htmlInfo.data[7]) + ", " + str_toString(htmlInfo.data[8]) + ", " + str_toString(htmlInfo.data[9]) + "]")
print("  (60='<', 33='!', 68='D', 79='O', 67='C'...)")
print("")

// Test 6: File Size Comparison
print("📊 File Size Comparison")
print("─────────────────────────────────────────────────────────")
let totalSize = htmlInfo.size + cssInfo.size + jsInfo.size
print("  HTML:  " + str_toString(htmlInfo.size) + " bytes")
print("  CSS:   " + str_toString(cssInfo.size) + " bytes")
print("  JS:    " + str_toString(jsInfo.size) + " bytes")
print("  ──────────────────")
print("  Total: " + str_toString(totalSize) + " bytes")
print("")

print("╔════════════════════════════════════════════════════════╗")
print("║                 ✓ All Tests Passed!                    ║")
print("╚════════════════════════════════════════════════════════╝")
