// Fibonacci Program in Kuyil Language
// Demonstrates recursive and iterative approaches

print("╔═══════════════════════════════════════════════════════╗")
print("║         FIBONACCI SEQUENCE GENERATOR                  ║")
print("╚═══════════════════════════════════════════════════════╝\n")

// ============================================================================
// RECURSIVE FIBONACCI (Simple but slow for large numbers)
// ============================================================================

fn fibonacciRecursive(n) {
    if (n <= 1) {
        return n
    }
    return fibonacciRecursive(n - 1) + fibonacciRecursive(n - 2)
}

// ============================================================================
// ITERATIVE FIBONACCI (Fast and efficient)
// ============================================================================

fn fibonacciIterative(n) {
    if (n <= 1) {
        return n
    }
    
    let a = 0
    let b = 1
    let i = 2
    
    while (i <= n) {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    
    return b
}

// ============================================================================
// GENERATE FIBONACCI SEQUENCE
// ============================================================================

fn generateFibonacciSequence(count) {
    let sequence = []
    let i = 0
    
    while (i < count) {
        let fib = fibonacciIterative(i)
        sequence = sequence + [fib]
        i = i + 1
    }
    
    return sequence
}

// ============================================================================
// DEMO: RECURSIVE APPROACH
// ============================================================================

print("─────────────────────────────────────────────────────────")
print("RECURSIVE FIBONACCI (first 10 numbers)")
print("─────────────────────────────────────────────────────────\n")

let i = 0
while (i < 10) {
    let fib = fibonacciRecursive(i)
    print("F(", i, ") = ", fib)
    i = i + 1
}

// ============================================================================
// DEMO: ITERATIVE APPROACH
// ============================================================================

print("\n─────────────────────────────────────────────────────────")
print("ITERATIVE FIBONACCI (first 20 numbers)")
print("─────────────────────────────────────────────────────────\n")

i = 0
while (i < 20) {
    let fib = fibonacciIterative(i)
    print("F(", i, ") = ", fib)
    i = i + 1
}

