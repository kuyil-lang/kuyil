// ============================================================================
// DEMO: LARGE FIBONACCI NUMBERS
// ============================================================================

print("\n─────────────────────────────────────────────────────────")
print("LARGE FIBONACCI NUMBERS")
print("─────────────────────────────────────────────────────────\n")

let largeNumbers = [30, 35, 40, 45]
i = 0
while (i < 4) {  // Fixed: use literal count instead of len()
    let n = largeNumbers[i]
    let fib = fibonacciIterative(n)
    print("F(", n, ") = ", fib)
    i = i + 1
}

// ============================================================================
// DEMO: FIBONACCI RATIOS (Golden Ratio Approximation)
// ============================================================================

print("\n─────────────────────────────────────────────────────────")
print("FIBONACCI RATIOS (approaching Golden Ratio φ ≈ 1.618)")
print("─────────────────────────────────────────────────────────\n")

i = 2
while (i <= 15) {
    let current = fibonacciIterative(i)
    let previous = fibonacciIterative(i - 1)
    let ratio = current / previous
    print("F(", i, ") / F(", i - 1, ") = ", ratio)
    i = i + 1
}

