// Decorator Syntax Demo - @inject Parameter Decorators
// This demonstrates @inject decorator syntax (runtime behavior not yet implemented)

print("╔═══════════════════════════════════════════════════════════╗")
print("║    @inject Decorator - Syntax Demo (Parser Support)      ║")
print("╚═══════════════════════════════════════════════════════════╝")
print("")
print("Note: @inject runtime behavior is not yet implemented.")
print("This demo shows that the syntax is parsed correctly.")
print("")

// ============================================================================
// Setup: Register Dependencies
// ============================================================================
print("Setup: Registering Dependencies")
print("───────────────────────────────────────────────────────────")

// Register a database connection
register_dependency("db", "DatabaseConnection{host=localhost,port=5432}")
print("✓ Registered 'db' dependency")

// Register a logger
register_dependency("logger", "Logger{level=INFO}")
print("✓ Registered 'logger' dependency")

// Register a config object
register_dependency("config", "Config{env=production}")
print("✓ Registered 'config' dependency")

// Register an API client
register_dependency("apiClient", "APIClient{baseUrl=https://api.example.com}")
print("✓ Registered 'apiClient' dependency")

print("")

// ============================================================================
// Example 1: Basic Dependency Injection
// ============================================================================
print("Example 1: Simple Database Injection")
print("───────────────────────────────────────────────────────────")

fn createUser(db, username, email) {
    print("  → Database connection: " + db)
    print("  → Creating user: " + username + " (" + email + ")")
    return "User created in " + db
}

print("Calling createUser (manually passing db for now - @inject not yet implemented):")
let result1 = createUser("DatabaseConnection{host=localhost,port=5432}", "john_doe", "john@example.com")
print("Result: " + result1)
print("")

// ============================================================================
// Example 2: Multiple Injections (syntax demo)
// ============================================================================
print("Example 2: Multiple Dependencies (Syntax)")
print("───────────────────────────────────────────────────────────")

fn processOrder(@inject db, @inject logger, orderId, amount) {
    print("  → Processing order #" + orderId + " for $" + amount)
    print("  → Database: " + db)
    print("  → Logger: " + logger)
    return "Order processed"
}

print("Checking parameter decorators:")
let params2 = @get("processOrder", "params")
print("processOrder parameter decorators: " + params2)
print("")

print("Calling processOrder (manually passing dependencies):")
let result2 = processOrder("DatabaseConnection{}", "Logger{}", "ORD-123", "99.99")
print("Result: " + result2)
print("")

// ============================================================================
// Example 3: Config Injection
// ============================================================================
print("Example 3: Configuration Injection")
print("───────────────────────────────────────────────────────────")

fn initializeApp(@inject config, appName) {
    print("  → Config: " + config)
    print("  → Initializing app: " + appName)
    return "App initialized with config"
}

print("Calling initializeApp:")
let result3 = initializeApp("MyApplication")
print("Result: " + result3)
print("")

// ============================================================================
// Example 4: API Client Injection
// ============================================================================
print("Example 4: API Client Injection")
print("───────────────────────────────────────────────────────────")

fn fetchRemoteData(@inject apiClient, endpoint) {
    print("  → API Client: " + apiClient)
    print("  → Fetching from endpoint: " + endpoint)
    return "Data from " + endpoint
}

print("Calling fetchRemoteData:")
let result4 = fetchRemoteData("/users")
print("Result: " + result4)
print("")

// ============================================================================
// Example 5: Mixed Injected and Regular Parameters
// ============================================================================
print("Example 5: Mixed Parameters")
print("───────────────────────────────────────────────────────────")

fn updateUserProfile(@inject db, @inject logger, userId, newEmail, newPhone) {
    print("  → DB: " + db)
    print("  → Logger: " + logger)
    print("  → Updating user: " + userId)
    print("  → New email: " + newEmail)
    print("  → New phone: " + newPhone)
    return "Profile updated"
}

print("Calling updateUserProfile:")
let result5 = updateUserProfile("user_123", "newemail@example.com", "555-1234")
print("Result: " + result5)
print("")

// ============================================================================
// Example 6: Service Layer Pattern
// ============================================================================
print("Example 6: Service Layer Pattern")
print("───────────────────────────────────────────────────────────")

fn UserService_create(@inject db, @inject logger, userData) {
    print("  [UserService] Dependencies injected:")
    print("    - Database: " + db)
    print("    - Logger: " + logger)
    print("  [UserService] Creating user with data: " + userData)
    return "User service completed"
}

print("Calling UserService_create:")
let result6 = UserService_create("userData{name=Alice,age=30}")
print("Result: " + result6)
print("")

// ============================================================================
// Example 7: Repository Pattern
// ============================================================================
print("Example 7: Repository Pattern")
print("───────────────────────────────────────────────────────────")

fn UserRepository_findById(@inject db, id) {
    print("  [UserRepository] Database: " + db)
    print("  [UserRepository] Finding user with ID: " + id)
    return "User found: {id: " + id + ", name: John}"
}

print("Calling UserRepository_findById:")
let result7 = UserRepository_findById("42")
print("Result: " + result7)
print("")

// ============================================================================
// Example 8: Transaction Management
// ============================================================================
print("Example 8: Transaction Management")
print("───────────────────────────────────────────────────────────")

fn executeTransaction(@inject db, @inject logger, operations) {
    print("  [TRANSACTION] Starting with:")
    print("    - DB: " + db)
    print("    - Logger: " + logger)
    print("  [TRANSACTION] Operations: " + operations)
    print("  [TRANSACTION] Committing...")
    return "Transaction successful"
}

print("Calling executeTransaction:")
let result8 = executeTransaction("INSERT,UPDATE,DELETE")
print("Result: " + result8)
print("")

// ============================================================================
// Example 9: Dynamic Dependency Update
// ============================================================================
print("Example 9: Dynamic Dependency Update")
print("───────────────────────────────────────────────────────────")

// Update a dependency at runtime
register_dependency("db", "DatabaseConnection{host=prod-db,port=3306}")
print("✓ Updated 'db' dependency to production database")

fn queryDatabase(@inject db, query) {
    print("  → Using DB: " + db)
    print("  → Executing query: " + query)
    return "Query results"
}

print("Calling queryDatabase (using updated dependency):")
let result9 = queryDatabase("SELECT * FROM users")
print("Result: " + result9)
print("")

