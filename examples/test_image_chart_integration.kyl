print("Use Case 8: Extract Chart Colors for Analysis\n")
print("----------------------------------------------")

print("Scenario: Analyze color distribution in chart\n")

print("Analysis pattern:")
print("  let chartImg = image_load(\"chart.png\")")
print("  let w = image_width(chartImg)")
print("  let h = image_height(chartImg)")
print("")
print("  // Sample colors from chart regions")
print("  let colorCounts = {}")
print("  ")
print("  let y = 0")
print("  while y < h {")
print("      let x = 0")
print("      while x < w {")
print("          let pixel = image_get_pixel(chartImg, x, y)")
print("          // Classify pixel color")
print("          // ... count color frequencies ...")
print("          x = x + 10  // Sample every 10 pixels")
print("      }")
print("      y = y + 10")
print("  }")
print("")
print("  // Use color stats for accessibility checks")
print("  // Verify sufficient contrast ratios")
print("")

print("✓ Color analysis pattern shown\n")

// ============================================
// Best Practices
// ============================================

print("=== Best Practices for Integration ===\n")

print("1. Workflow Order:")
print("   - Generate charts first (data → visualization)")
print("   - Process charts as images second (enhancement)")
print("   - Compose final output third (layout)")
print("   - Optimize and export last (format conversion)\n")

print("2. File Format Strategy:")
print("   - Generate: PNG (lossless intermediate)")
print("   - Process: PNG (preserve quality)")
print("   - Web output: PNG (small) or JPEG (photos)")
print("   - Print output: PDF or high-res PNG")
print("   - Archive: Original SVG + processed PNG\n")

print("3. Memory Management:")
print("   - Destroy images after use: image_destroy(img)")
print("   - Process charts in batches to limit memory")
print("   - Delete intermediate files after composition")
print("   - Use streaming for large batch operations\n")

print("4. Quality Settings:")
print("   - Charts: Generate at 2-3x target size, downscale")
print("   - Thumbnails: Use bicubic interpolation")
print("   - Print: 300 DPI minimum (e.g., 2400x1800 for 8x6\")")
print("   - Web: 72-96 DPI sufficient (800x600 typical)\n")

print("5. Accessibility:")
print("   - Ensure chart text remains readable after processing")
print("   - Maintain sufficient contrast after blending")
print("   - Avoid over-sharpening (creates artifacts)")
print("   - Test color-blind accessibility before filtering\n")

print("6. Performance Optimization:")
print("   - Cache generated charts")
print("   - Use appropriate image sizes (don't over-generate)")
print("   - Batch process similar operations")
print("   - Use async/parallel for multiple charts")
print("   - Profile memory usage for large reports\n")

print("7. Common Patterns:")
print("   - Report: Chart → Resize → Overlay logo → Save PDF")
print("   - Dashboard: Multiple charts → Grid layout → Web PNG")
print("   - Alert: Chart → Highlight region → Add border → Email")
print("   - Archive: Chart → Watermark → Thumbnail → Storage")
print("   - Presentation: Chart → Enhance → High-res → Print\n")

print("8. Error Handling:")
print("   - Check image_load() returns before processing")
print("   - Validate dimensions before overlay operations")
print("   - Verify chart_render_*() success")
print("   - Handle missing files gracefully")
print("   - Provide fallback for unsupported formats\n")

print("9. Automation Tips:")
print("   - Template-based chart generation")
print("   - Batch processing with loops")
print("   - Scheduled report generation (cron)")
print("   - Event-triggered visualizations")
print("   - Data pipeline integration\n")

print("10. Real-World Use Cases:")
print("    - Business reports: Charts + company branding")
print("    - Monitoring dashboards: Real-time metric visualization")
print("    - Email alerts: Inline chart images")
print("    - Social media: Infographic generation")
print("    - Scientific papers: Publication-quality figures")
print("    - Web analytics: Automated insight images")
print("    - Mobile apps: Thumbnail generation")
print("    - E-commerce: Product chart comparisons\n")

print("✓ Image and chart integration examples complete\n")
