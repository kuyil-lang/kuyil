// Decorator Runtime Behavior - @wrap() Handler Example
// This demonstrates how @wrap() decorators intercept and modify function behavior

print("╔═══════════════════════════════════════════════════════════╗")
print("║     @wrap() Decorator - Runtime Handler Execution        ║")
print("╚═══════════════════════════════════════════════════════════╝")
print("")

// ============================================================================
// Example 1: Simple Logging Handler
// ============================================================================
print("Example 1: Logging Handler")
print("───────────────────────────────────────────────────────────")

fn loggingHandler(originalFunc, args) {
    print("  [LOG] Function called")
    print("  [LOG] Executing original function...")
    
    // Call the original function with the first argument
    let result = originalFunc(args[0])
    
    print("  [LOG] Function returned")
    return result
}

@wrap(handler=loggingHandler)
fn calculateSum(x) {
    print("    → Inside calculateSum: " + x)
    return x + 10
}

print("Calling calculateSum(5):")
let result1 = calculateSum(5)
print("Result: " + result1)
print("")

// ============================================================================
// Example 2: Performance Timing Handler
// ============================================================================
print("Example 2: Performance Timing")
print("───────────────────────────────────────────────────────────")

fn timingHandler(originalFunc, args) {
    print("  [TIMING] Starting...")
    let result = originalFunc(args[0])
    print("  [TIMING] Completed")
    return result
}

@wrap(handler=timingHandler)
fn expensiveOperation(data) {
    print("    → Processing: " + data)
    // Simulate work
    let sum = 0
    let i = 0
    while (i < 100) {
        sum = sum + i
        i = i + 1
    }
    return "Processed: " + data
}

print("Calling expensiveOperation:")
let result2 = expensiveOperation("user_data")
print("Result: " + result2)
print("")

// ============================================================================
// Example 3: Caching Handler
// ============================================================================
print("Example 3: Caching Handler (Mock)")
print("───────────────────────────────────────────────────────────")

fn cachingHandler(originalFunc, args) {
    let key = args[0]
    print("  [CACHE] Checking cache for: " + key)
    print("  [CACHE] Cache miss - calling function")
    
    let result = originalFunc(args[0])
    
    print("  [CACHE] Storing result in cache")
    return result
}

@wrap(handler=cachingHandler)
fn fetchUserData(userId) {
    print("    → Fetching data from database for user: " + userId)
    return "User data for " + userId
}

print("Calling fetchUserData('123'):")
let result3 = fetchUserData("123")
print("Result: " + result3)
print("")

// ============================================================================
// Example 4: Error Handling Wrapper
// ============================================================================
print("Example 4: Error Handling Wrapper")
print("───────────────────────────────────────────────────────────")

fn errorHandler(originalFunc, args) {
    print("  [ERROR HANDLER] Wrapping function call")
    
    // In a real implementation, this would try/catch
    let result = originalFunc(args[0])
    
    print("  [ERROR HANDLER] Call succeeded")
    return result
}

@wrap(handler=errorHandler)
fn riskyOperation(value) {
    print("    → Executing risky operation with: " + value)
    return "Success: " + value
}

print("Calling riskyOperation('test'):")
let result4 = riskyOperation("test")
print("Result: " + result4)
print("")

// ============================================================================
// Example 5: Authorization Wrapper
// ============================================================================
print("Example 5: Authorization Check")
print("───────────────────────────────────────────────────────────")

fn authorizationHandler(originalFunc, args) {
    print("  [AUTH] Checking permissions...")
    
    // Mock authorization check
    let hasPermission = true
    
    if (hasPermission) {
        print("  [AUTH] Permission granted - executing function")
        return originalFunc(args[0])
    } else {
        print("  [AUTH] Permission denied")
        return "Access denied"
    }
}

@wrap(handler=authorizationHandler)
fn deleteUser(userId) {
    print("    → Deleting user: " + userId)
    return "User " + userId + " deleted"
}

print("Calling deleteUser('admin_user'):")
let result5 = deleteUser("admin_user")
print("Result: " + result5)
print("")

// ============================================================================
// Example 6: Retry Handler
// ============================================================================
print("Example 6: Retry Logic")
print("───────────────────────────────────────────────────────────")

fn retryHandler(originalFunc, args) {
    print("  [RETRY] Attempt 1...")
    let result = originalFunc(args[0])
    
    // In real implementation, would retry on failure
    print("  [RETRY] Success on first attempt")
    return result
}

@wrap(handler=retryHandler)
fn unreliableNetworkCall(url) {
    print("    → Making network request to: " + url)
    return "Response from " + url
}

print("Calling unreliableNetworkCall:")
let result6 = unreliableNetworkCall("api.example.com")
print("Result: " + result6)
print("")

// ============================================================================
// Example 7: Validation Wrapper
// ============================================================================
print("Example 7: Input Validation")
print("───────────────────────────────────────────────────────────")

fn validationHandler(originalFunc, args) {
    let input = args[0]
    print("  [VALIDATE] Checking input: " + input)
    
    // Mock validation
    let isValid = true
    
    if (isValid) {
        print("  [VALIDATE] Input valid - proceeding")
        return originalFunc(input)
    } else {
        print("  [VALIDATE] Invalid input")
        return "Validation failed"
    }
}

@wrap(handler=validationHandler)
fn processInput(data) {
    print("    → Processing validated input: " + data)
    return "Processed: " + data
}

print("Calling processInput:")
let result7 = processInput("valid_data")
print("Result: " + result7)
print("")

