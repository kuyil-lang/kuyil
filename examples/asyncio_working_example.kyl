// Working Example: Asyncio with Headers & Timeouts
// Uses the interface file which registers function signatures

print("═══════════════════════════════════════")
print("  Asyncio with Headers & Timeouts")
print("═══════════════════════════════════════\n")

// Load asyncio interface
import("interfaces/interface_asyncio.kyl")
print("Loaded asyncio library\n")

print("1. Simple HTTP GET:")
print("   URL: https://httpbin.org/get")
let req1 = httpGet("https://httpbin.org/get", nil)
print("   Request ID:", req1)
let result1 = waitResult(req1, 10000)  // 10 second timeout
if (result1 != nil) {
    print("   Result received")
} else {
    print("   Timeout or error")
}
print("   ✓ Success\n")

print("2. HTTP GET with custom headers:")
let headers = [
    "User-Agent: Kuyil/1.0",
    "Accept: application/json",
    "X-Custom-Header: test123"
]
print("   URL: https://httpbin.org/headers")
print("   Headers: Custom UA and headers")
let req2 = httpGetEx(
    "https://httpbin.org/headers",
    headers,
    0,      // dns_timeout (0 = use default)
    1000,   // connect_timeout (1 second)
    3000,   // read_timeout (3 seconds)
    500     // write_timeout (500ms)
)
let result2 = waitResult(req2, 10000)
if (result2 != nil) {
    print("   Result received")
} else {
    print("   Timeout or error")
}
print("   ✓ Headers sent\n")

print("3. HTTP POST with JSON body and headers:")
let post_body = '{"name": "Kuyil", "version": "1.0", "feature": "asyncio"}'
let post_headers = [
    "Content-Type: application/json",
    "Accept: application/json"
]
print("   URL: https://httpbin.org/post")
print("   Body: JSON data")
let req3 = asyncio_httpPostEx(
    "https://httpbin.org/post",
    post_body,
    post_headers,
    0, 1000, 3000, 500
)
let result3 = waitResult(req3, 10000)
if (result3 != nil) {
    print("   Result received")
} else {
    print("   Timeout or error")
}
print("   ✓ POST successful\n")

print("4. Multiple concurrent requests:")
print("   Starting 3 requests simultaneously...")
let req_a = httpGet("https://httpbin.org/delay/1", nil)
let req_b = httpGet("https://httpbin.org/delay/1", nil)
let req_c = httpGet("https://httpbin.org/delay/1", nil)

print("   Waiting for all to complete...")
let res_a = waitResult(req_a, 10000)
let res_b = waitResult(req_b, 10000)
let res_c = waitResult(req_c, 10000)
print("   All requests completed!")
if (res_a != nil) { print("   Result A: received") }
if (res_b != nil) { print("   Result B: received") }
if (res_c != nil) { print("   Result C: received") }
print("   ✓ Concurrent requests work\n")

print("═══════════════════════════════════════")
print("  All tests passed! ✓")
print("═══════════════════════════════════════")
