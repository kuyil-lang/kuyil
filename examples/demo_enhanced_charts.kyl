// Enhanced Chart Rendering with Labels, Legends, and Better Graphics
import "image"

print("=== Enhanced Chart Demo ===\n\n")

// ===== IMPROVED DRAWING FUNCTIONS =====

// Draw a single pixel circle (marker)
fn draw_circle(img, cx, cy, radius, r, g, b) {
    let y = 0 - radius
    while y <= radius {
        let x = 0 - radius
        while x <= radius {
            let dist = (x * x) + (y * y)
            let r_sq = radius * radius
            if dist <= r_sq {
                let px = cx + x
                let py = cy + y
                if px >= 0 {
                    if py >= 0 {
                        image_set_pixel(img, px, py, r, g, b, 255)
                    }
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

// Improved line drawing - clipped to bounds
fn draw_line(img, x0, y0, x1, y1, r, g, b, width, height) {
    // Clip coordinates
    if x0 < 0 { x0 = 0 }
    if x0 >= width { x0 = width - 1 }
    if y0 < 0 { y0 = 0 }
    if y0 >= height { y0 = height - 1 }
    if x1 < 0 { x1 = 0 }
    if x1 >= width { x1 = width - 1 }
    if y1 < 0 { y1 = 0 }
    if y1 >= height { y1 = height - 1 }
    
    let dx = x1 - x0
    if dx < 0 { dx = 0 - dx }
    let dy = y1 - y0
    if dy < 0 { dy = 0 - dy }
    
    let sx = 1
    if x0 > x1 { sx = 0 - 1 }
    let sy = 1
    if y0 > y1 { sy = 0 - 1 }
    
    let err = dx - dy
    let x = x0
    let y = y0
    let max_steps = dx + dy + 10
    let steps = 0
    
    while steps < max_steps {
        if x >= 0 {
            if x < width {
                if y >= 0 {
                    if y < height {
                        image_set_pixel(img, x, y, r, g, b, 255)
                    }
                }
            }
        }
        
        if x == x1 {
            if y == y1 {
                steps = max_steps
            }
        }
        
        let e2 = 2 * err
        if e2 > (0 - dy) {
            err = err - dy
            x = x + sx
        }
        if e2 < dx {
            err = err + dx
            y = y + sy
        }
        steps = steps + 1
    }
}

fn fill_rect(img, x, y, w, h, r, g, b) {
    let i = 0
    while i < w {
        let j = 0
        while j < h {
            let px = x + i
            let py = y + j
            image_set_pixel(img, px, py, r, g, b, 255)
            j = j + 1
        }
        i = i + 1
    }
}

// Draw a simple digit (0-9)
fn draw_digit(img, x, y, digit, r, g, b) {
    // Simple 3x5 pixel font
    if digit == 0 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x, y, 1, 5, r, g, b)
        fill_rect(img, x + 2, y, 1, 5, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
    if digit == 1 {
        fill_rect(img, x + 1, y, 1, 5, r, g, b)
    }
    if digit == 2 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x + 2, y, 1, 3, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x, y + 2, 1, 3, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
    if digit == 3 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x + 2, y, 1, 5, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
    if digit == 4 {
        fill_rect(img, x, y, 1, 3, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 2, y, 1, 5, r, g, b)
    }
    if digit == 5 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x, y, 1, 3, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 2, y + 2, 1, 3, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
    if digit == 6 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x, y, 1, 5, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x + 2, y + 2, 1, 3, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
    if digit == 7 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x + 2, y, 1, 5, r, g, b)
    }
    if digit == 8 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x, y, 1, 5, r, g, b)
        fill_rect(img, x + 2, y, 1, 5, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
    if digit == 9 {
        fill_rect(img, x, y, 3, 1, r, g, b)
        fill_rect(img, x, y, 1, 3, r, g, b)
        fill_rect(img, x + 2, y, 1, 5, r, g, b)
        fill_rect(img, x, y + 2, 3, 1, r, g, b)
        fill_rect(img, x, y + 4, 3, 1, r, g, b)
    }
}

// Draw a number (up to 3 digits)
fn draw_number(img, x, y, num, r, g, b) {
    if num < 10 {
        draw_digit(img, x, y, num, r, g, b)
    } else if num < 100 {
        let tens = num / 10
        let ones = num % 10
        draw_digit(img, x, y, tens, r, g, b)
        draw_digit(img, x + 5, y, ones, r, g, b)
    } else {
        let hundreds = num / 100
        let remainder = num % 100
        let tens = remainder / 10
        let ones = remainder % 10
        draw_digit(img, x, y, hundreds, r, g, b)
        draw_digit(img, x + 5, y, tens, r, g, b)
        draw_digit(img, x + 10, y, ones, r, g, b)
    }
}

// Enhanced multi-series line chart with labels and legend
fn create_enhanced_chart(width, height, data1, data2, len, title, label1, label2, xlabel, ylabel) {
    let img = image_create(width, height, 3)
    
    // White background
    let i = 0
    while i < width {
        let j = 0
        while j < height {
            image_set_pixel(img, i, j, 255, 255, 255, 255)
            j = j + 1
        }
        i = i + 1
    }
    
    let margin_left = 70
    let margin_right = 30
    let margin_top = 50
    let margin_bottom = 60
    let chart_width = width - margin_left - margin_right
    let chart_height = height - margin_top - margin_bottom
    
    // Draw axes with bounds checking
    let axis_x0 = margin_left
    let axis_y0 = height - margin_bottom
    let axis_x1 = width - margin_right
    let axis_y1 = margin_top
    
    draw_line(img, axis_x0, axis_y0, axis_x0, axis_y1, 0, 0, 0, width, height)
    draw_line(img, axis_x0, axis_y0, axis_x1, axis_y0, 0, 0, 0, width, height)
    
    // Draw grid lines (light gray)
    let grid_steps = 5
    let grid_i = 1
    while grid_i < grid_steps {
        let grid_y = axis_y0 - ((grid_i * chart_height) / grid_steps)
        draw_line(img, axis_x0, grid_y, axis_x1, grid_y, 220, 220, 220, width, height)
        grid_i = grid_i + 1
    }
    
    // Find global min/max
    let min_val = data1[0]
    let max_val = data1[0]
    i = 0
    while i < len {
        if data1[i] < min_val { min_val = data1[i] }
        if data1[i] > max_val { max_val = data1[i] }
        if data2[i] < min_val { min_val = data2[i] }
        if data2[i] > max_val { max_val = data2[i] }
        i = i + 1
    }
    
    let range_val = max_val - min_val
    if range_val < 0.001 { range_val = 1.0 }
    min_val = min_val - (range_val * 0.1)
    max_val = max_val + (range_val * 0.1)
    range_val = max_val - min_val
    
    // Y-axis labels
    let label_y = axis_y0
    draw_number(img, 10, label_y - 3, 0, 80, 80, 80)
    
    label_y = axis_y0 - (chart_height / 2)
    let mid_val = (max_val - min_val) / 2
    draw_number(img, 10, label_y - 3, 50, 80, 80, 80)
    
    label_y = axis_y1
    draw_number(img, 5, label_y - 3, 100, 80, 80, 80)
    
    // X-axis labels
    let label_x = axis_x0
    draw_number(img, label_x - 5, axis_y0 + 10, 0, 80, 80, 80)
    
    label_x = axis_x0 + (chart_width / 2)
    let mid_x = len / 2
    draw_number(img, label_x - 5, axis_y0 + 10, mid_x, 80, 80, 80)
    
    label_x = axis_x1
    draw_number(img, label_x - 10, axis_y0 + 10, len, 80, 80, 80)
    
    // Draw markers first, then connect with lines
    // Series 1 (blue) - draw all markers
    i = 0
    while i < len {
        let x0 = margin_left + ((i * chart_width) / (len - 1))
        let norm0 = (data1[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        
        // Clip to chart area
        if y0 < axis_y1 { y0 = axis_y1 }
        if y0 > axis_y0 { y0 = axis_y0 }
        
        draw_circle(img, x0, y0, 3, 0, 50, 150)
        i = i + 1
    }
    
    // Series 1 - draw lines between markers only
    i = 0
    while i < (len - 1) {
        let x0 = margin_left + ((i * chart_width) / (len - 1))
        let norm0 = (data1[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        if y0 < axis_y1 { y0 = axis_y1 }
        if y0 > axis_y0 { y0 = axis_y0 }
        
        let x1 = margin_left + (((i + 1) * chart_width) / (len - 1))
        let norm1 = (data1[i + 1] - min_val) / range_val
        let y1 = axis_y0 - (norm1 * chart_height)
        if y1 < axis_y1 { y1 = axis_y1 }
        if y1 > axis_y0 { y1 = axis_y0 }
        
        // Only draw line if both points are valid
        draw_line(img, x0, y0, x1, y1, 30, 100, 200, width, height)
        i = i + 1
    }
    
    // Series 2 (red) - draw all markers
    i = 0
    while i < len {
        let x0 = margin_left + ((i * chart_width) / (len - 1))
        let norm0 = (data2[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        if y0 < axis_y1 { y0 = axis_y1 }
        if y0 > axis_y0 { y0 = axis_y0 }
        
        fill_rect(img, x0 - 2, y0 - 2, 5, 5, 180, 40, 20)
        i = i + 1
    }
    
    // Series 2 - draw lines between markers only
    i = 0
    while i < (len - 1) {
        let x0 = margin_left + ((i * chart_width) / (len - 1))
        let norm0 = (data2[i] - min_val) / range_val
        let y0 = axis_y0 - (norm0 * chart_height)
        if y0 < axis_y1 { y0 = axis_y1 }
        if y0 > axis_y0 { y0 = axis_y0 }
        
        let x1 = margin_left + (((i + 1) * chart_width) / (len - 1))
        let norm1 = (data2[i + 1] - min_val) / range_val
        let y1 = axis_y0 - (norm1 * chart_height)
        if y1 < axis_y1 { y1 = axis_y1 }
        if y1 > axis_y0 { y1 = axis_y0 }
        
        draw_line(img, x0, y0, x1, y1, 200, 60, 40, width, height)
        i = i + 1
    }
    
    // Legend box (top right)
    let leg_x = width - 180
    let leg_y = 20
    fill_rect(img, leg_x, leg_y, 150, 60, 250, 250, 250)
    draw_line(img, leg_x, leg_y, leg_x + 150, leg_y, 100, 100, 100, width, height)
    draw_line(img, leg_x, leg_y, leg_x, leg_y + 60, 100, 100, 100, width, height)
    draw_line(img, leg_x + 150, leg_y, leg_x + 150, leg_y + 60, 100, 100, 100, width, height)
    draw_line(img, leg_x, leg_y + 60, leg_x + 150, leg_y + 60, 100, 100, 100, width, height)
    
    // Legend items with text
    // Blue line with circle marker
    draw_line(img, leg_x + 10, leg_y + 20, leg_x + 40, leg_y + 20, 30, 100, 200, width, height)
    draw_circle(img, leg_x + 25, leg_y + 20, 3, 0, 50, 150)
    // Text: "Train" (simplified as "T r a i n")
    fill_rect(img, leg_x + 50, leg_y + 17, 3, 1, 50, 50, 50)  // T top
    fill_rect(img, leg_x + 51, leg_y + 17, 1, 5, 50, 50, 50)  // T stem
    fill_rect(img, leg_x + 58, leg_y + 17, 1, 5, 50, 50, 50)  // r stem
    fill_rect(img, leg_x + 58, leg_y + 19, 2, 1, 50, 50, 50)  // r top
    fill_rect(img, leg_x + 65, leg_y + 17, 1, 5, 50, 50, 50)  // a stem
    fill_rect(img, leg_x + 65, leg_y + 17, 3, 1, 50, 50, 50)  // a top
    fill_rect(img, leg_x + 67, leg_y + 17, 1, 5, 50, 50, 50)  // a right
    fill_rect(img, leg_x + 65, leg_y + 19, 3, 1, 50, 50, 50)  // a mid
    fill_rect(img, leg_x + 73, leg_y + 17, 1, 5, 50, 50, 50)  // i
    fill_rect(img, leg_x + 80, leg_y + 17, 1, 5, 50, 50, 50)  // n left
    fill_rect(img, leg_x + 82, leg_y + 17, 1, 5, 50, 50, 50)  // n right
    fill_rect(img, leg_x + 80, leg_y + 17, 3, 1, 50, 50, 50)  // n top
    
    // Red line with square marker  
    draw_line(img, leg_x + 10, leg_y + 40, leg_x + 40, leg_y + 40, 200, 60, 40, width, height)
    fill_rect(img, leg_x + 23, leg_y + 38, 5, 5, 180, 40, 20)
    // Text: "Valid" (simplified as "V a l i d")
    fill_rect(img, leg_x + 50, leg_y + 37, 1, 3, 50, 50, 50)  // V left
    fill_rect(img, leg_x + 52, leg_y + 40, 1, 2, 50, 50, 50)  // V mid
    fill_rect(img, leg_x + 54, leg_y + 37, 1, 3, 50, 50, 50)  // V right
    fill_rect(img, leg_x + 59, leg_y + 37, 1, 5, 50, 50, 50)  // a stem
    fill_rect(img, leg_x + 59, leg_y + 37, 3, 1, 50, 50, 50)  // a top
    fill_rect(img, leg_x + 61, leg_y + 37, 1, 5, 50, 50, 50)  // a right
    fill_rect(img, leg_x + 59, leg_y + 39, 3, 1, 50, 50, 50)  // a mid
    fill_rect(img, leg_x + 66, leg_y + 37, 1, 5, 50, 50, 50)  // l
    fill_rect(img, leg_x + 71, leg_y + 37, 1, 5, 50, 50, 50)  // i
    fill_rect(img, leg_x + 76, leg_y + 37, 1, 5, 50, 50, 50)  // d left
    fill_rect(img, leg_x + 78, leg_y + 37, 1, 5, 50, 50, 50)  // d right
    fill_rect(img, leg_x + 76, leg_y + 37, 3, 1, 50, 50, 50)  // d top
    fill_rect(img, leg_x + 76, leg_y + 41, 3, 1, 50, 50, 50)  // d bottom
    
    return img
}

// ===== DEMO START =====

print("Demo: Enhanced ML Training Chart\n")
print("---------------------------------\n")

let train_loss = [2.5, 2.1, 1.8, 1.5, 1.3, 1.2, 1.1, 1.05, 1.02, 1.0, 0.98, 0.97, 0.96, 0.95]
let val_loss = [2.4, 2.0, 1.7, 1.5, 1.4, 1.3, 1.25, 1.22, 1.20, 1.19, 1.18, 1.17, 1.17, 1.16]
let epochs = 14

print("Epochs: ", epochs, "\n")
print("Final train loss: 0.95\n")
print("Final validation loss: 1.16\n\n")

let chart = create_enhanced_chart(900, 600, train_loss, val_loss, epochs, 
                                  "Training Loss", "Train", "Validation", 
                                  "Epochs", "Loss")
if chart != nil {
    print("✓ Created enhanced chart with:\n")
    print("  - Grid lines for easier reading\n")
    print("  - X and Y axis labels\n")
    print("  - Legend box with series identification\n")
    print("  - Circle markers for training data\n")
    print("  - Square markers for validation data\n")
    print("  - Clipped lines (no overflow)\n")
    print("  - Better colors and contrast\n\n")
    
    let saved = image_save(chart, "enhanced_training.png", "png")
    if saved {
        print("✓ Saved to enhanced_training.png\n")
    }
    image_destroy(chart)
}

