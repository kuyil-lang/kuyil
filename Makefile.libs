SUBDIRS = math str http datetime fileio
# Windows builds skip http library (requires curl/libcurl setup)
SUBDIRS_WINDOWS = math str datetime fileio

.PHONY: all clean $(SUBDIRS) cross-windows cross-windows-32 cross-macos macos

all: $(SUBDIRS)

$(SUBDIRS):
	$(MAKE) -C shared_libs/$@

# Cross-compilation for Windows (64-bit)
cross-windows:
	@echo "Building shared libraries for Windows (x86_64)..."
	@echo "Note: Skipping http library (requires libcurl-devel for MinGW)"
	@for dir in $(SUBDIRS_WINDOWS); do \
		echo "Building $$dir for Windows..."; \
		$(MAKE) -C shared_libs/$$dir \
			CC=x86_64-w64-mingw32-gcc \
			CFLAGS="-Wall -Wextra -std=c99 -O2 -DWIN32 -D_WIN32_WINNT=0x0600" \
			TARGET="../../libs/libkyl$$dir.dll" || true; \
	done
	@echo "Windows shared libraries built in libs/"

# Cross-compilation for Windows (32-bit)
cross-windows-32:
	@echo "Building shared libraries for Windows (i686/32-bit)..."
	@echo "Note: Skipping http library (requires libcurl-devel for MinGW)"
	@for dir in $(SUBDIRS_WINDOWS); do \
		echo "Building $$dir for Windows 32-bit..."; \
		$(MAKE) -C shared_libs/$$dir \
			CC=i686-w64-mingw32-gcc \
			CFLAGS="-Wall -Wextra -std=c99 -O2 -DWIN32 -D_WIN32_WINNT=0x0600" \
			TARGET="../../libs/libkyl$$dir-win32.dll" || true; \
	done
	@echo "Windows 32-bit shared libraries built in libs/"

# Cross-compilation for macOS
cross-macos:
	@echo "Building shared libraries for macOS (x86_64)..."
	@if ! command -v x86_64-apple-darwin20.4-clang >/dev/null 2>&1; then \
		echo "Error: OSXCross not found. Use 'make macos' on native macOS instead."; \
		exit 1; \
	fi
	@for dir in $(SUBDIRS); do \
		echo "Building $$dir for macOS..."; \
		$(MAKE) -C shared_libs/$$dir \
			CC=x86_64-apple-darwin20.4-clang \
			CFLAGS="-Wall -Wextra -std=c99 -O2 -fPIC" \
			TARGET="../../libs/libkyl$$dir.dylib"; \
	done
	@echo "macOS shared libraries built in libs/"

# Native macOS build
macos:
	@echo "Building shared libraries for macOS (native)..."
	@for dir in $(SUBDIRS); do \
		echo "Building $$dir for macOS..."; \
		$(MAKE) -C shared_libs/$$dir \
			CC=clang \
			CFLAGS="-Wall -Wextra -std=c99 -O2 -fPIC -mmacosx-version-min=10.13" \
			TARGET="../../libs/libkyl$$dir.dylib"; \
	done
	@echo "macOS shared libraries built in libs/"

clean:
	for dir in $(SUBDIRS); do \
		$(MAKE) -C shared_libs/$$dir clean; \
	done
	rm -f libs/*.so libs/*.dll libs/*.dylib
