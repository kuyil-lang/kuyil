// List Workspace Files - POST /api/workspace/files
@route(method="GET", path="/api/workspace/files", bridge=true)
fn handleListWorkspaceFiles(request, response) {
    print("[API] /api/workspace/files")
    print("[API] Workspace path: " + g_workspace_path)
    
    // Use find command to list all .kyl files recursively
    let findCmd = "find " + g_workspace_path + " -type f -name '*.kyl' 2>/dev/null"
    print("[API] Command: " + findCmd)
    let result = sys.capture(findCmd)
    
    if (result == nil || result == "") {
        print("[API] No files found")
        aio_response_setStatus(response, 200)
        aio_response_setBody(response, `{"success":true,"files":[]}`)
        return
    }
    
    // Split by newlines
    let lines = str_split(result, "\n")
    let numLines = array_length(lines)
    
    // Build JSON array
    let jsonArray = "["
    let added = 0
    let i = 0
    
    while (i < numLines && i < 100) {
        let line = lines[i]
        
        if (line != nil && line != "") {
            let trimmed = str_trim(line)
            if (trimmed != "") {
                // Remove workspace path prefix
                let relativePath = str_replace(trimmed, g_workspace_path, "")
                
                // Remove leading slash
                let pathLen = str_length(relativePath)
                if (pathLen > 0 && str_substring(relativePath, 0, 1) == "/") {
                    relativePath = str_substring(relativePath, 1, pathLen)
                }
                
                if (added > 0) {
                    jsonArray = jsonArray + ","
                }
                jsonArray = jsonArray + `"` + relativePath + `"`
                added = added + 1
            }
        }
        i = i + 1
    }
    
    jsonArray = jsonArray + "]"
    
    // Build final result carefully to avoid memory issues
    let prefix = `{"success":true,"files":`
    let suffix = `}`
    let finalResult = prefix + jsonArray + suffix
    
    print("[API] Returning " + added + " files")
    print("[API] Final result: " + finalResult)
    print("[API] Final result length: " + str_length(finalResult))
    aio_response_setStatus(response, 200)
    aio_response_setBody(response, finalResult)
    return
}

// Save File - POST /api/files/save
@route(method="POST", path="/api/files/save", bridge=true)
fn handleSaveFile(request, response) {
    print("[API] /api/files/save")
    
    let body = parseBody(request.body)
    
    let path = body.path
    let content = body.content
    
    if (path == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No path provided"}`)
        return
    }
    
    print("[API] Saving: " + path)
    print("[API] Content length: " + sys.length(content))
    print(content)
    
    let fullPath = resolvePath(path)
    print("[API] Full path: " + fullPath)
    
    // Create parent directories if needed
    let lastSlash = -1
    let i = 0
    let pathLen = str_length(fullPath)
    while (i < pathLen) {
        let char = str_substring(fullPath, i, i + 1)
        if (char == "/") {
            lastSlash = i
        }
        i = i + 1
    }
    
    if (lastSlash > 0) {
        let dirPath = str_substring(fullPath, 0, lastSlash)
        print("[API] Ensuring parent dir: " + dirPath)
        sys.capture("mkdir -p \"" + dirPath + "\"")
    }
    
    // Unescape the content to convert escape sequences to actual characters
    content = unescapeContent(content)
    
    let success = file.file_writeText(fullPath, content)
    
    if (success) {
        print("[API] File saved successfully")
        aio_response_setStatus(response, 200)
        aio_response_setBody(response, `{"success":true}`)
        return
    } else {
        print("[API] Failed to save file")
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Failed to save file at ` + fullPath + `"}`)
        return
    }
}

// Rename File - POST /api/files/rename
@route(method="POST", path="/api/files/rename", bridge=true)
fn handleRenameFile(request, response) {
    print("[API] /api/files/rename")
    
    let body = parseBody(request.body)
    let oldPath = body.oldPath
    let newPath = body.newPath
    
    if (oldPath == nil || newPath == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"Missing paths"}`)
        return
    }
    
    let fullOldPath = g_workspace_path + oldPath
    let fullNewPath = g_workspace_path + newPath
    
    print("[API] Renaming: " + fullOldPath + " -> " + fullNewPath)
    
    let result = sys.capture("mv " + fullOldPath + " " + fullNewPath + " && echo 0 || echo 1")
    
    if (str_substring(result, 0, 1) == "0") {
        print("[API] File renamed")
        aio_response_setStatus(response, 200)
        aio_response_setBody(response, `{"success":true}`)
        return
    } else {
        print("[API] Failed to rename")
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Failed to rename file"}`)
        return
    }
}

// Load LLM Actions Config - GET /api/llm/config
@route(method="GET", path="/api/llm/config", bridge=true)
fn handleGetLLMConfig(request, response) {
    print("[API] /api/llm/config")
    
    let configPath = "kuyil-ide/llm_actions.yaml"
    
    if (file.file_exists(configPath)) {
        let content = file.file_readText(configPath)
        if (content != nil) {
            print("[API] Config loaded, length: " + str_length(content))
            aio_response_setStatus(response, 200)
            aio_response_addHeader(response, "Content-Type", "text/plain")
            aio_response_setBody(response, content)
            return
        }
    }
    
    print("[API] Config file not found")
    aio_response_setStatus(response, 404)
    aio_response_setBody(response, `{"error":"LLM config not found"}`)
    return
}

// Process LLM Action - POST /api/llm/action
@route(method="POST", path="/api/llm/action", bridge=true)
fn handleLLMAction(request, response) {
    print("[API] /api/llm/action")
    
    let body = parseBody(request.body)
    let action = body.action
    let userPrompt = body.prompt
    let currentCode = body.currentCode
    let executionOutput = body.executionOutput
    let exitCode = body.exitCode
    let model = body.model
    
    if (action == nil || action == "") {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No action specified"}`)
        return
    }
    
    if (userPrompt == nil) {
        userPrompt = ""
    }
    
    if (model == nil || model == "") {
        model = "qwen2.5-coder:32b"
    }
    
    print("[API] Action: " + action)
    print("[API] Model: " + model)
    print("[API] Prompt length: " + str_length(userPrompt))
    
    // Build the complete prompt
    let fullPrompt = userPrompt
    
    // Add current code if provided
    if (currentCode != nil && currentCode != "") {
        fullPrompt = fullPrompt + "\n\nCurrent code:\n```kuyil\n" + currentCode + "\n```"
    }
    
    // Add execution output if provided
    if (executionOutput != nil && executionOutput != "") {
        fullPrompt = fullPrompt + "\n\nExecution output:\n```\n" + executionOutput + "\n```"
        if (exitCode != nil) {
            fullPrompt = fullPrompt + "\nExit code: " + exitCode
        }
    }
    
    print("[API] Full prompt length: " + str_length(fullPrompt))
    
    // Use C library jsonStringify for proper Unicode and escape handling
    let escapedPrompt = json.transcode_jsonStringify(fullPrompt)
    
    // Build Ollama request body with properly escaped prompt
    let ollamaBody = `{"model":"` + model + `","prompt":` + escapedPrompt + `,"stream":false}`
    let ollamaUrl = "http://127.0.0.1:11434/api/generate"
    
    print("[API] Calling Ollama...")
    let ollamaResponse = httpc.http_clientPostEx(ollamaUrl, ollamaBody)
    
    if (ollamaResponse == nil) {
        print("[API] Ollama error")
        aio_response_setStatus(response, 503)
        aio_response_setBody(response, `{"error":"Cannot connect to Ollama"}`)
        return
    }
    
    print("[API] Ollama response OK")
    aio_response_setStatus(response, 200)
    aio_response_setBody(response, ollamaResponse)
    return
}

// Execute Code - POST /api/code/execute
@route(method="POST", path="/api/code/execute", bridge=true)
fn handleExecuteCode(request, response) {
    print("[API] /api/code/execute")
    
    let body = parseBody(request.body)
    let code = body.code
    let filename = body.filename
    
    if (code == nil || code == "") {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No code provided"}`)
        return
    }
    
    // Use provided filename or create temp file
    let tempFile = ""
    if (filename != nil && filename != "") {
        tempFile = resolvePath(filename)
    } else {
        tempFile = g_workspace_path + ".temp_exec.kyl"
    }
    
    print("[API] Writing code to: " + tempFile)
    
    // Unescape and write code
    code = unescapeContent(code)
    let writeSuccess = file.file_writeText(tempFile, code)
    
    if (!writeSuccess) {
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Failed to write code file"}`)
        return
    }
    
    // Execute with full capture of stdout, stderr, and exit code
    print("[API] Executing: ./kuyil " + tempFile)
    let execCmd = "cd /home/vmukumar/akish/kuyil && ./kuyil " + tempFile + " 2>&1; echo \"__EXIT_CODE__:$?\""
    let output = sys.capture(execCmd)
    
    // Parse output and exit code
    let exitCode = 0
    let stdout = output
    
    // Extract exit code from marker - use simple string search
    let exitMarker = "__EXIT_CODE__:"
    let markerIdx = str_indexOf(output, exitMarker)
    
    if (markerIdx >= 0) {
        // Get stdout (everything before marker)
        stdout = str_substring(output, 0, markerIdx)
        
        // Get exit code string (everything after marker)
        let exitStart = markerIdx + str_length(exitMarker)
        let exitStr = str_substring(output, exitStart, str_length(output))
        exitStr = str_trim(exitStr)
        
        // Convert to integer manually (safer than sys.parseInt)
        if (exitStr == "0") {
            exitCode = 0
        }
        if (exitStr == "1") {
            exitCode = 1
        }
        if (exitStr == "2") {
            exitCode = 2
        }
        if (exitStr != "" && exitStr != "0" && exitStr != "1" && exitStr != "2") {
            // Try to extract first digit for other codes
            let firstChar = str_substring(exitStr, 0, 1)
            if (firstChar == "0") {
                exitCode = 0
            }
            if (firstChar == "1") {
                exitCode = 1
            }
            if (firstChar == "2") {
                exitCode = 2
            }
            if (firstChar == "3") {
                exitCode = 3
            }
            if (firstChar != "0" && firstChar != "1" && firstChar != "2" && firstChar != "3") {
                exitCode = 1
            }
        }
    }
    
    // Clean up temp file if we created one
    if (filename == nil || filename == "") {
        sys.capture("rm -f " + tempFile)
    }
    
    print("[API] Execution complete. Exit code: " + exitCode)
    
    // Build JSON response manually to avoid escaping issues
    let jsonResponse = `{"success":true,"exitCode":` + exitCode + `,"stdout":"`
    
    // Escape special characters in stdout for JSON
    let stdoutEscaped = str_regexReplace(stdout, "\\\\", "\\\\\\\\")
    stdoutEscaped = str_regexReplace(stdoutEscaped, "\"", "\\\\\"")
    stdoutEscaped = str_regexReplace(stdoutEscaped, "\n", "\\\\n")
    stdoutEscaped = str_regexReplace(stdoutEscaped, "\r", "\\\\r")
    stdoutEscaped = str_regexReplace(stdoutEscaped, "\t", "\\\\t")
    
    jsonResponse = jsonResponse + stdoutEscaped + `"}`
    
    aio_response_setStatus(response, 200)
    aio_response_setBody(response, jsonResponse)
    return
}

// ============================================
// Main Application
// ============================================

fn main() {
    print("╔══════════════════════════════════════════════════════╗")
    print("║            Kuyil AI IDE - Unified Mode              ║")
    print("╚══════════════════════════════════════════════════════╝\n")
    
    // Check environment variable for mode (set KUYIL_IDE_MODE=remote for HTTP server)
    let mode_env = sys.capture("echo -n $KUYIL_IDE_MODE")
    if (mode_env != nil && mode_env != "") {
        g_mode = mode_env
    }
    
    print("Mode: " + g_mode)
    
    // Create workspace directory if it doesn't exist
    let mkdirCmd = "mkdir -p " + g_workspace_path
    sys.capture(mkdirCmd)
    print("✓ Workspace: " + g_workspace_path)
    
    print("✓ @route handlers registered:")
    print("  POST /api/ai/generate")
    print("  POST /api/bridge/fetch")
    print("  POST /api/files/read")
    print("  POST /api/files/create")
    print("  POST /api/files/save")
    print("  POST /api/files/rename")
    print("  POST /api/folders/create")
    print("  POST /api/files/delete")
    print("  POST /api/files/list")
    print("  POST /api/workspace/files")
    print("  POST /api/code/execute")
    print("  GET  /api/llm/config")
    print("  POST /api/llm/action")
    print("  POST /api/docs/read")
    print("  GET  /api/docs/list")
    print("  GET  /api/health")
    
    if (g_mode == "remote") {
        print("\n🚀 Starting async HTTP server on port 3000...")
        print("   Remote access mode - use http://localhost:3000\n")
        print("   Note: @route handlers are automatically registered with async I/O\n")
        
        // Start the async HTTP server with @route support
        let serverStarted = http_start_server(3000)
        
        if (!serverStarted) {
            print("ERROR: Failed to start async HTTP server on port 3000")
            print("       Make sure port 3000 is not already in use")
            return
        }
        
        print("✓ Async HTTP server started on port 3000")
        
        // Configure static file serving
        print("  Configuring static file serving...")
        let staticResult = http_static_add("/", "kuyil-ide/assets")
        
        if (staticResult) {
            print("  ✓ Static files: / -> kuyil-ide/assets")
        } else {
            print("  ✗ Failed to configure static file serving")
        }
        
        print("\n✓ Async HTTP server running on http://0.0.0.0:3000")
        print("  ✓ Static file serving with MIME types")
        print("  ✓ @route handlers automatically integrated")
        print("  Access IDE at: http://localhost:3000/index.html")
        print("  Press Ctrl+C to stop\n")
        
        // Keep server running - the async I/O system handles requests
        while (true) {
            sys.sleep(1000)
        }
    } else {
        print("\n🚀 Starting webview with direct bridge routing...")
        print("   IDE mode - fetch() calls automatically routed to @route handlers\n")
        
        // Run webview app - fetch calls are intercepted and routed to @route handlers
        runWebViewAppFromDist("Kuyil AI IDE", "kuyil-ide/assets")
    }
}

main()
