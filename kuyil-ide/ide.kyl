// Kuyil AI IDE - Supports both IDE mode and Remote mode
// Usage: ./kuyil kuyil-ide/ide_bridge.kyl (IDE mode, default)
//        KUYIL_IDE_MODE=remote ./kuyil kuyil-ide/ide_bridge.kyl (HTTP server mode)

import("interfaces/interface_system.kyl") as sys
import("interfaces/interface_fileio.kyl") as file
import("interfaces/interface_webview_app.kyl") as app
import("interfaces/interface_str.kyl") as str
import("interfaces/interface_transcoder.kyl") as json
import("interfaces/interface_crypto.kyl") as crypto
import("interfaces/interface_http_client_ex.kyl") as httpc
//import("interfaces/interface_http.kyl") as http

// ============================================
// Configuration
// ============================================

let g_workspace_path = "kuyil-ide/workspace/"
let g_mode = "ide"  // "ide" for webview, "remote" for HTTP server

// ============================================
// Helper Functions
// ============================================

fn parseBody(bodyStr) {
    if (bodyStr == nil || bodyStr == "") {
        return nil
    }
    if (typeof(bodyStr) != "string") {
        return bodyStr  // Already parsed
    }
    return json.transcode_jsonParse(bodyStr)
}

// Resolve path - if path already has workspace prefix, use as-is, otherwise prepend
fn resolvePath(path) {
    let workspacePrefix = "kuyil-ide/workspace/"
    let pathStart = str_substring(path, 0, str_length(workspacePrefix))
    if (pathStart == workspacePrefix) {
        return path
    }
    return g_workspace_path + path
}

// Unescape content to convert escape sequences to actual characters
fn unescapeContent(content) {
    if (content == nil) {
        return ""
    }
    // Unescape JSON escape sequences to actual characters
    // Must process double-backslash FIRST before other escapes
    content = str_regexReplace(content, "\\\\\\\\", "\x01")  // Temporarily protect \\ with placeholder
    content = str_regexReplace(content, "\\\\r\\\\n", "\n")  // Windows CRLF (\r\n -> newline)
    content = str_regexReplace(content, "\\\\n", "\n")       // Unix LF (\n -> newline)
    content = str_regexReplace(content, "\\\\t", "\t")       // Tab (\t -> tab)
    content = str_regexReplace(content, "\\\\r", "\r")       // CR (\r -> carriage return)
    content = str_regexReplace(content, '\\\\"', '"')        // Quote (\" -> ")
    content = str_regexReplace(content, "\x01", "\\")        // Restore protected backslashes
    return content
}

// JSON stringify helper - escapes string for use in JSON
fn jsonStringify(str) {
    if (str == nil) {
        return '""'
    }
    // Escape special characters for JSON
    let escaped = str_regexReplace(str, "\\\\", "\\\\\\\\")  // Backslash first
    escaped = str_regexReplace(escaped, "\"", "\\\\\"")       // Quote
    escaped = str_regexReplace(escaped, "\n", "\\\\n")        // Newline
    escaped = str_regexReplace(escaped, "\r", "\\\\r")        // Carriage return
    escaped = str_regexReplace(escaped, "\t", "\\\\t")        // Tab
    return '"' + escaped + '"'
}

// ============================================
// API Routes using @route decorator
// Routes are automatically intercepted by webview fetch()
// ============================================

// Static file handler - serves files from assets directory
@route(method="GET", path="/index.html", bridge=true)
fn handleIndexHtml(request, response) {
    let filePath = "kuyil-ide/assets/index.html"
    if (file.file_exists(filePath)) {
        let content = file.file_readText(filePath)
        if (content != nil) {
            aio_response_setStatus(response, 200)
            aio_response_setHeader(response, "Content-Type", "text/html; charset=utf-8")
            aio_response_setBody(response, content)
            return
        }
    }
    aio_response_setStatus(response, 404)
    aio_response_setBody(response, "File not found")
}

// Root route - redirects to index.html
@route(method="GET", path="/", bridge=true)
fn handleRoot(request, response) {
    response.status = 302
    response.headers["Location"] = "/index.html"
    response.body = ""
    return response
}

// AI Generate - POST /api/ai/generate
@route(method="POST", path="/api/ai/generate", bridge=true)
fn handleAiGenerate(request, response) {
    print("[API] /api/ai/generate")
    
    let body = parseBody(request.body)
    print("[API] Body type: " + typeof(body))
    
    // Get prompt from body
    let prompt = body.prompt
    if (prompt == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No prompt provided"}`)
        return
    }
    
    // Unescape if needed
    if (typeof(prompt) == "string") {
        prompt = sys.unescape(prompt)
    }
    
    print("[API] Prompt: " + str_substring(prompt, 0, 100))
    
    // Call Ollama
    let ollamaBody = `{"model":"llama3.1:8b","prompt":"` + prompt + `","stream":false}`
    let ollamaUrl = "http://127.0.0.1:11434/api/generate"
    
    let ollamaResponse = httpc.http_clientPostEx(ollamaUrl, ollamaBody, {})
    
    if (ollamaResponse.status != 200) {
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Ollama error"}`)
        return
    }
    
    print("[API] Ollama response OK")
    aio_response_setStatus(response, 200)
    aio_response_setBody(response, ollamaResponse.body)
}

// Fetch Bridge - POST /api/bridge/fetch
// Direct passthrough to Ollama
@route(method="POST", path="/api/bridge/fetch", bridge=true)
fn handleFetchBridge(request, response) {
    print("[API] /api/bridge/fetch START")
    
    if (request == nil) {
        print("[API] ERROR: request is nil")
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"Request is nil"}`)
        return
    }
    
    print("[API] request type: " + typeof(request))
    
    // Body comes as STRING (already unescaped by framework)
    let bodyStr = request.body
    print("[API] body type: " + typeof(bodyStr))
    
    if (bodyStr == nil || bodyStr == "") {
        print("[API] ERROR: body is empty")
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No body in request"}`)
        return
    }
    
    print("[API] Body string length: " + str_length(bodyStr))
    print("[API] Body preview: " + str_substring(bodyStr, 0, 150))
    
    // Forward directly to Ollama
    let url = "http://127.0.0.1:11434/api/generate"
    
    let bodyLen = str_length(bodyStr)
    print("[API] Calling Ollama at: " + url)
    print("[API] Body length: " + bodyLen)
    
    // Check for reasonable body size
    if (bodyLen > 100000) {
        print("[API] ERROR: Body too large (" + bodyLen + " bytes)")
        aio_response_setStatus(response, 413)
        aio_response_setBody(response, `{"error":"Request body too large"}`)
        return
    }
    
    // Call HTTP client - now returns string directly
    print("[API] Making HTTP POST request...")
    let ollamaResponse = httpc.http_clientPostEx(url, bodyStr)
    
    // Try to use the value directly without checking
    print("[API] Trying to get length...")
    let responseLen = str_length(ollamaResponse)
    print("[API] Response length: " + responseLen)
    
    if (ollamaResponse == nil) {
        print("[API] ERROR: HTTP client returned nil - is Ollama running?")
        aio_response_setStatus(response, 503)
        aio_response_setBody(response, `{"error":"Cannot connect to Ollama. Make sure Ollama is running on port 11434"}`)
        return
    }
    
    print("[API] String length: " + ollamaResponse.length)
    
    // Return response directly
    print("[API] Setting response status 200")
    aio_response_setStatus(response, 200)
    
    print("[API] Setting response body from ollamaResponse string")
    aio_response_setBody(response, ollamaResponse)
    
    print("[API] Response set - handler complete")
}

// Read File - POST /api/files/read
@route(method="POST", path="/api/files/read", bridge=true)
fn handleReadFile(request, response) {
    print("[API] /api/files/read")
    
    let body = parseBody(request.body)
    let path = body.path
    
    if (path == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No path provided"}`)
        return
    }
    
    print("[API] Reading: " + path)
    
    // Prepend workspace path if needed
    let fullPath = path
    let pathLen = str_length(path)
    if (pathLen > 0) {
        let wpl = str_length(g_workspace_path)
        let wsPrefix = str_substring(path, 0, wpl)
        if (wsPrefix != g_workspace_path) {
            fullPath = g_workspace_path + path
        }
    }
    
    if (file.file_exists(fullPath)) {
        let content = file.file_readText(fullPath)
        if (content != nil) {
            print("[API] File read, length: " + str_length(content))
            aio_response_setStatus(response, 200)
            aio_response_addHeader(response, "Content-Type", "text/plain")
            aio_response_setBody(response, content)
            return
        }
    }
    
    print("[API] File not found")
    aio_response_setStatus(response, 404)
    aio_response_setBody(response, `{"error":"File not found"}`)
    return
}

// Create File - POST /api/files/create
@route(method="POST", path="/api/files/create", bridge=true)
fn handleCreateFile(request, response) {
    print("[API] /api/files/create")
    print("[API] request.body type: " + typeof(request.body))
    print("[API] request.body: " + request.body)
    
    let body = parseBody(request.body)
    print("[API] parsed body type: " + typeof(body))
    
    if (body == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"Empty body"}`)
        return
    }
    
    let path = body["path"]
    let content = body["content"]

    print("[API] path: " + path)
    print("[API] content type: " + typeof(content))
    
    if (path == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No path provided"}`)
        return
    }
    
    print("[API] Creating: " + path)
    
    let fullPath = resolvePath(path)
    print("[API] Full path: " + fullPath)
    
    // Create parent directories if needed
    let lastSlash = -1
    let i = 0
    let pathLen = str_length(fullPath)
    while (i < pathLen) {
        let char = str_substring(fullPath, i, i + 1)
        if (char == "/") {
            lastSlash = i
        }
        i = i + 1
    }
    
    if (lastSlash > 0) {
        let dirPath = str_substring(fullPath, 0, lastSlash)
        print("[API] Creating parent dir: " + dirPath)
        sys.capture("mkdir -p \"" + dirPath + "\"")
    }
    
    // Unescape the content to convert escape sequences to actual characters
    content = unescapeContent(content)
    
    print("[API] Final content length: " + sys.length(content))
    let success = file.file_writeText(fullPath, content)
    
    if (success) {
        print("[API] File created successfully")
        aio_response_setStatus(response, 201)
        aio_response_setBody(response, `{"success":true,"path":"` + fullPath + `"}`)
        return
    } else {
        print("[API] Failed to create file - file_writeText returned false")
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Failed to create file at ` + fullPath + `"}`)
        return
    }
}

// Create Folder - POST /api/folders/create
@route(method="POST", path="/api/folders/create", bridge=true)
fn handleCreateFolder(request, response) {
    print("[API] /api/folders/create")
    
    let body = parseBody(request.body)
    let path = body.path
    
    if (path == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No path provided"}`)
        return
    }
    
    let fullPath = resolvePath(path)
    
    print("[API] Creating folder: " + fullPath)
    
    let result = sys.capture("mkdir -p " + fullPath + " && echo 0 || echo 1")
    
    if (str_substring(result, 0, 1) == "0") {
        print("[API] Folder created")
        aio_response_setStatus(response, 201)
        aio_response_setBody(response, `{"success":true,"path":"` + fullPath + `"}`)
        return
    } else {
        print("[API] Failed to create folder")
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Failed to create folder"}`)
        return
    }
}

// Delete File - POST /api/files/delete
@route(method="POST", path="/api/files/delete", bridge=true)
fn handleDeleteFile(request, response) {
    print("[API] /api/files/delete")
    
    let body = parseBody(request.body)
    let path = body.path
    
    if (path == nil) {
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No path provided"}`)
        return
    }
    
    let fullPath = resolvePath(path)
    print("[API] Deleting: " + fullPath)
    
    let result = sys.capture("rm -f " + fullPath + " && echo 0 || echo 1")
    
    if (str_substring(result, 0, 1) == "0") {
        print("[API] File deleted")
        aio_response_setStatus(response, 200)
        aio_response_setBody(response, `{"success":true}`)
        return
    } else {
        print("[API] Failed to delete file")
        aio_response_setStatus(response, 500)
        aio_response_setBody(response, `{"error":"Failed to delete file"}`)
        return
    }
}

// List Files - POST /api/files/list
@route(method="POST", path="/api/files/list", bridge=true)
fn handleListFiles(request, response) {
    print("[API] /api/files/list")
    
    let body = request.body
    let path = body.path
    
    if (path == nil) {
        path = ""
    }
    
    let fullPath = g_workspace_path + path
    print("[API] Listing: " + fullPath)
    
    // Use ls command to list files and directories
    let cmdResult = sys.capture("ls -1 " + fullPath + " 2>/dev/null")
    
    if (cmdResult == nil || cmdResult == "") {
        aio_response_setStatus(response, 200)
        aio_response_setBody(response, `{"files":[]}`)
        return
    }
    
    // Split by newlines and build JSON array
    let lines = str_split(cmdResult, "\n")
    let numLines = array_length(lines)
    let jsonArray = "["
    let added = 0
    let i = 0
    
    while (i < numLines) {
        let line = lines[i]
        if (line != nil && line != "") {
            let trimmed = str_trim(line)
            if (trimmed != "") {
                if (added > 0) {
                    jsonArray = jsonArray + ","
                }
                jsonArray = jsonArray + `"` + trimmed + `"`
                added = added + 1
            }
        }
        i = i + 1
    }
    
    jsonArray = jsonArray + "]"
    print("[API] Found " + added + " items")
    
    aio_response_setStatus(response, 200)
    aio_response_setBody(response, `{"files":` + jsonArray + `}`)
    return
}

// Read Documentation - POST /api/docs/read
@route(method="POST", path="/api/docs/read", bridge=true)
fn handleReadDocs(request, response) {
    print("[API] /api/docs/read - Handler called")
    print("[API] request type: " + typeof(request))
    print(request)
    print(request.body)
    
    if (request == nil) {
        print("[API] ERROR: request is nil")
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No request object"}`)
        return
    }
    
    // Request is now always an object (parsed by caller)
    // Body is also parsed if it was JSON string
    let body = parseBody(request.body)
    print("[API] Body field type: " + typeof(body))
    
    if (body == nil) {
        print("[API] ERROR: Empty body")
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"Empty body"}`)
        return
    }
    
    // Body is now an object (parsed by caller if it was JSON string)
    let docName = body.docName
    print("[API] docName: " + docName)
    
    if (docName == nil || docName == "") {
        print("[API] No docName found")
        aio_response_setStatus(response, 400)
        aio_response_setBody(response, `{"error":"No document name provided"}`)
        return
    }
    
    print("[API] Reading doc: " + docName)
    
    let docPath = "/home/vmukumar/akish/kuyil/docs/" + docName
    let content = file.file_readText(docPath)
    if (content != nil) {
        print("[API] Doc found, length: " + str_length(content))
        aio_response_setStatus(response, 200)
        aio_response_addHeader(response, "Content-Type", "text/plain")
        aio_response_setBody(response, content)
        return
    }
    
    print("[API] Doc not found")
    aio_response_setStatus(response, 404)
    aio_response_setBody(response, `{"error":"Documentation not found"}`)
    return
}

// List Documentation - GET /api/docs/list
@route(path="/api/docs/list", bridge=true)
fn handleListDocs(request, response) {
    print("[API] /api/docs/list")
    
    // Scan actual docs directory
    let docsPath = "/home/vmukumar/akish/kuyil/docs/"
    let cmdResult = sys.capture("ls -1 " + docsPath + "*.md 2>/dev/null | xargs -n1 basename")
    
    if (cmdResult == nil || cmdResult == "") {
        print("[API] No docs found")
        aio_response_setStatus(response, 200)
        aio_response_setBody(response, `{"docs":[]}`)
        return
    }
    
    // Split by newlines and build JSON array
    let lines = str_split(cmdResult, "\n")
    let numLines = array_length(lines)
    let jsonArray = "["
    let added = 0
    let i = 0
    
    while (i < numLines) {
        let line = lines[i]
        if (line != nil && line != "") {
            let trimmed = str_trim(line)
            if (trimmed != "" && str_substring(trimmed, str_length(trimmed) - 3, str_length(trimmed)) == ".md") {
                if (added > 0) {
                    jsonArray = jsonArray + ","
                }
                jsonArray = jsonArray + `"` + trimmed + `"`
                added = added + 1
            }
        }
        i = i + 1
    }
    
    jsonArray = jsonArray + "]"
    print("[API] Found " + added + " docs")
    
    aio_response_setStatus(response, 200)
    aio_response_setBody(response, `{"docs":` + jsonArray + `}`)
    return
}

