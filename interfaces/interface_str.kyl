// Interface for String library
interface str from "libs/libkylstr.so" {
  @alias("length")
  int32 str_length(input: string)
  
  @alias("substring")
  string str_substring(input: string, start: int32, end: int32)
  
  @alias("upper")
  string str_upper(input: string)
  
  @alias("lower")
  string str_lower(input: string)
  
  @alias("trim")
  string str_trim(input: string)
  
  @alias("startsWith")
  bool str_startsWith(input: string, prefix: string)
  
  @alias("endsWith")
  bool str_endsWith(input: string, suffix: string)
  
  @alias("contains")
  bool str_contains(haystack: string, needle: string)
  
  @alias("replace")
  string str_replace(input: string, from: string, to: string)
  
  @alias("split")
  string str_split(input: string, delimiter: string)
  
  @alias("toNumber")
  float64 str_toNumber(input: string)
  
  @alias("toString")
  string str_toString(value: number)
  
  @alias("slice")
  string str_slice(input: string, start: int32, end: int32)
  
  @alias("regexMatch")
  bool str_regexMatch(input: string, pattern: string)
  
  @alias("regexExtract")
  string str_regexExtract(input: string, pattern: string)
}
