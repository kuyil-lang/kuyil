// Interface for Math library
// Load library at runtime
loadlib("libs/libkylmath.so")

interface math {
  @alias("abs")
  float64 math_abs(x: float64)
  
  @alias("floor")
  float64 math_floor(x: float64)
  
  @alias("ceil")
  float64 math_ceil(x: float64)
  
  @alias("round")
  float64 math_round(x: float64)
  
  @alias("sqrt")
  float64 math_sqrt(x: float64)
  
  @alias("pow")
  float64 math_pow(x: float64, y: float64)
  
  @alias("sin")
  float64 math_sin(x: float64)
  
  @alias("cos")
  float64 math_cos(x: float64)
  
  @alias("tan")
  float64 math_tan(x: float64)
}
