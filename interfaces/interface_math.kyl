// Interface for Math library
@loadlib("./libs/libkylmath.so");

interface math {
  float64 abs(x: float64)
  float64 floor(x: float64)
  float64 ceil(x: float64)
  float64 round(x: float64)
  float64 sqrt(x: float64)
  float64 pow(x: float64, y: float64)
  float64 sin(x: float64)
  float64 cos(x: float64)
  float64 tan(x: float64)
}
