// Interface for System utilities library
interface system from "libs/libkylsystem.so" {
  // Sleep for specified milliseconds
  // Example: system.sleep(1000) - sleep for 1 second  
  any sleep(milliseconds: any)
  
  // Get current timestamp in milliseconds since epoch
  @alias("timestamp")
  any timestamp()
  
  // Unescape a JSON string: convert \" to " and \\ to \
  // Example: unescape("{\"key\":\"value\"}") returns {"key":"value"}
  string unescape(str: string)
}
