// Interface for FFmpeg library
@loadlib("./libs/libkylffmpeg.so");

// General ffmpeg helpers
interface ffmpeg {
  string getLastError()
  bool   clearError()
}

// Audio-related functions
interface audio {
  float64 getDuration(path: string)
  int32   getSampleRate(path: string)
  int32   getChannels(path: string)
  int32   load(path: string)
  bool    save(handle: int32, path: string)
  bool    segmentFree(handle: int32)
  int32   trim(handle: int32, startMs: float64, endMs: float64)
  int32   fadeIn(handle: int32, durationMs: float64)
  int32   fadeOut(handle: int32, durationMs: float64)
  int32   adjustVolume(handle: int32, factor: float64)
  int32   normalize(handle: int32)
  int32   concat(handle1: int32, handle2: int32)
  int32   merge(handle1: int32, handle2: int32)
  int32   overlay(base: int32, overlay: int32, positionMs: float64)
  int32   speedChange(handle: int32, factor: float64)
  int32   reverse(handle: int32)
}

// Audio editor
interface editor {
  int32 create()
  bool  destroy(handle: int32)
}
