// Interface for SQLite library
interface sqlite from "libs/libkylsqlite.so" {
  @alias("openDatabase")
  int32 sqlite_openDatabase(path: string, flags: int32)
  
  @alias("closeDatabase")
  int32 sqlite_closeDatabase(handle: int32)
  
  @alias("executeSql")
  int32 sqlite_executeSql(handle: int32, sql: string)
  
  @alias("executeQuery")
  int32 sqlite_executeQuery(handle: int32, sql: string)
  
  @alias("freeResult")
  int32 sqlite_freeResult(handle: int32)
  
  @alias("getLastError")
  string sqlite_getLastError(handle: int32)
}

interface result {
  @alias("firstRow")
  int32 result_firstRow(handle: int32)
  
  @alias("nextRow")
  int32 result_nextRow(handle: int32)
}

interface row {
  @alias("getInt")
  int32 row_getInt(rowHandle: int32, colIndex: int32)
  
  @alias("getText")
  string row_getText(rowHandle: int32, colIndex: int32)
  
  @alias("getReal")
  float64 row_getReal(rowHandle: int32, colIndex: int32)
}
