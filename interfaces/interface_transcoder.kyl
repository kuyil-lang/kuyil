// Interface for Compression/Transcoder library
// Compression functions
interface compress from "libs/libkyltranscoder.so" {
  @alias("compressGzip")
  object compress_compressGzip(input: string)
  
  @alias("compressDeflate")
  object compress_compressDeflate(input: string)
  
  @alias("compressZip")
  string compress_compressZip(input: string)
}

// Decompression functions
interface decompress {
  @alias("decompressGzip")
  string decompress_decompressGzip(input: object)
  
  @alias("decompressDeflate")
  string decompress_decompressDeflate(input: object)
  
  @alias("decompressZip")
  string decompress_decompressZip(input: string)
}

// Transcoding utilities
interface transcode {
  @alias("urlEncode")
  string transcode_urlEncode(input: string)
  
  @alias("urlDecode")
  string transcode_urlDecode(input: string)
  
  @alias("htmlEncode")
  string transcode_htmlEncode(input: string)
  
  @alias("hexEncode")
  string transcode_hexEncode(input: string)
  
  @alias("hexDecode")
  string transcode_hexDecode(input: string)
  
  @alias("crc32")
  int32 transcode_crc32(input: string)
  
  @alias("compressionRatio")
  float64 transcode_compressionRatio(original: int32, compressed: int32)
  
  @alias("parse")
  object transcode_jsonParse(json: string)
  
  @alias("jsonStringify")
  string transcode_jsonStringify(input: string)
  
  @alias("jsonGetField")
  string transcode_jsonGetField(json: string, key: string)
}

// Unzip helper
interface unzip {
  @alias("toDirectory")
  bool unzip_toDirectory(zipPath: string)
}
