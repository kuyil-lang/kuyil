// Interface for Compression/Transcoder library
@loadlib("./libs/libkyltranscoder.so");

// Compression functions
interface compress {
  object compressGzip(input: string)
  object compressDeflate(input: string)
  string compressZip(input: string)
}

// Decompression functions
interface decompress {
  string decompressGzip(input: object)
  string decompressDeflate(input: object)
  string decompressZip(input: string)
}

// Transcoding utilities
interface transcode {
  string urlEncode(input: string)
  string urlDecode(input: string)
  string htmlEncode(input: string)
  string hexEncode(input: string)
  string hexDecode(input: string)
  int32  crc32(input: string)
  float64 compressionRatio(original: int32, compressed: int32)
}

// Unzip helper
interface unzip {
  bool toDirectory(zipPath: string)
}
