// Interface for File I/O library
interface file from "libs/libkylfileio.so" {
  @alias("readText")
  string file_readText(path: string)
  
  @alias("readCsv")
  array file_readCsv(path: string)
  
  @alias("readJson")
  object file_readJson(path: string)
  
  @alias("readYaml")
  object file_readYaml(path: string)
  
  @alias("exists")
  bool file_exists(path: string)
  
  @alias("size")
  int32 file_size(path: string)
  
  @alias("validate")
  bool file_validate(path: string)
  
  @alias("writeText")
  bool file_writeText(path: string, content: string)
}
