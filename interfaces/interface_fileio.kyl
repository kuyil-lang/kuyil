// Interface for File I/O library
interface file from "libs/libkylfileio.so" {
  @alias("readText")
  string readText(path: string)
  
  @alias("readCsv")
  array readCsv(path: string)
  
  @alias("readJson")
  object readJson(path: string)
  
  @alias("readYaml")
  object readYaml(path: string)
  
  @alias("exists")
  bool exists(path: string)
  
  @alias("size")
  int32 size(path: string)
  
  @alias("validate")
  bool validate(path: string)
  
  @alias("writeText")
  bool writeText(path: string, content: string)
  
  @alias("info")
  object info(path: string)
  
  @alias("listFiles")
  string listFiles(path: string)
}
