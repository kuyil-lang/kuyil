// Data Structures Library Interface for Kuyil
// Provides: Stack, Queue, PriorityQueue, List, TreeMap, Graph, ConcurrentHashMap, Decorators

// ============================================
// Stack (LIFO)
// ============================================
interface Stack from "libs/libkylds.so" {
    number ds_stackCreate() // Returns stack handle
    bool ds_stackDestroy(stack)
    bool ds_stackPush(stack, value)
    any ds_stackPop(stack) // Returns value or nil
    any ds_stackPeek(stack) // Returns value without removing
    number ds_stackSize(stack) // Returns size
    bool ds_stackIsEmpty(stack) // Returns boolean
    bool ds_stackClear(stack)
}

// ============================================
// Queue (FIFO)
// ============================================
interface Queue from "libs/libkylds.so" {
    number ds_queueCreate()
    bool ds_queueDestroy(queue)
    bool ds_queueEnqueue(queue, value)
    any ds_queueDequeue(queue) // Returns value or nil
    any ds_queuePeek(queue)
    number ds_queueSize(queue)
    bool ds_queueIsEmpty(queue)
    bool ds_queueClear(queue)
}

// ============================================
// Priority Queue (Min-Heap by default)
// ============================================
interface PriorityQueue from "libs/libkylds.so" {
    number ds_priorityQueueCreate(isMaxHeap) // isMaxHeap: 0=min-heap, 1=max-heap
    bool ds_priorityQueueDestroy(pq)
    bool ds_priorityQueueInsert(pq, priority, value) // priority is number, value is any
    object ds_priorityQueueExtract(pq) // Returns {priority, value} or nil
    object ds_priorityQueuePeek(pq)
    number ds_priorityQueueSize(pq)
    bool ds_priorityQueueIsEmpty(pq)
    bool ds_priorityQueueClear(pq)
    bool ds_priorityQueueChangePriority(pq, oldPriority, newPriority, value)
}

// ============================================
// List (Dynamic Array / ArrayList)
// ============================================
interface List from "libs/libkylds.so" {
    number ds_listCreate()
    bool ds_listDestroy(list)
    bool ds_listAdd(list, value) // Add to end
    bool ds_listInsert(list, index, value) // Insert at index
    any ds_listGet(list, index) // Get by index
    bool ds_listSet(list, index, value) // Set by index
    bool ds_listRemove(list, value) // Remove first occurrence
    any ds_listRemoveAt(list, index) // Remove by index
    number ds_listIndexOf(list, value) // Find index or -1
    bool ds_listContains(list, value) // Returns boolean
    number ds_listSize(list)
    bool ds_listIsEmpty(list)
    bool ds_listClear(list)
    bool ds_listSort(list) // Sort in ascending order
    bool ds_listReverse(list)
    array ds_listToArray(list) // Convert to Kuyil array
}

// ============================================
// TreeMap (Red-Black Tree / Sorted Map)
// ============================================
interface TreeMap from "libs/libkylds.so" {
    number ds_treeMapCreate()
    bool ds_treeMapDestroy(map)
    bool ds_treeMapPut(map, key, value) // Insert or update
    any ds_treeMapGet(map, key) // Get value by key or nil
    bool ds_treeMapRemove(map, key) // Remove by key
    bool ds_treeMapContains(map, key)
    number ds_treeMapSize(map)
    bool ds_treeMapIsEmpty(map)
    bool ds_treeMapClear(map)
    array ds_treeMapKeys(map) // Returns array of keys (sorted)
    array ds_treeMapValues(map) // Returns array of values
    any ds_treeMapFirstKey(map) // Min key
    any ds_treeMapLastKey(map) // Max key
    any ds_treeMapFloorKey(map, key) // Largest key <= key
    any ds_treeMapCeilingKey(map, key) // Smallest key >= key
}

// ============================================
// Graph (Directed/Undirected, Weighted/Unweighted)
// ============================================
interface Graph from "libs/libkylds.so" {
    number ds_graphCreate(vertexCount, isDirected) // vertexCount, 0=undirected, 1=directed
    bool ds_graphDestroy(graph)
    bool ds_graphAddEdge(graph, fromVertex, toVertex, weight) // weight optional (default 1.0)
    bool ds_graphRemoveEdge(graph, fromVertex, toVertex)
    bool ds_graphHasEdge(graph, fromVertex, toVertex)
    array ds_graphGetNeighbors(graph, vertexId) // Returns array of neighbor IDs
    number ds_graphVertexCount(graph)
    number ds_graphEdgeCount(graph)
    array ds_graphBFS(graph, startVertex) // Returns array of vertices in BFS order
    array ds_graphDFS(graph, startVertex) // Returns array of vertices in DFS order
    array ds_graphShortestPath(graph, fromVertex, toVertex) // Dijkstra's algorithm
    array ds_graphTopologicalSort(graph) // Returns array or nil if cycle
    array ds_graphConnectedComponents(graph) // Returns array of component arrays
    bool ds_graphIsAcyclic(graph) // Check if graph has cycles
    array ds_graphMinSpanningTree(graph) // MST for undirected weighted graph
}

// ============================================
// Concurrent HashMap (Thread-Safe)
// ============================================
interface ConcurrentHashMap from "libs/libkylds.so" {
    number ds_concurrentHashMapCreate(initialCapacity) // capacity hint
    bool ds_concurrentHashMapDestroy(map)
    bool ds_concurrentHashMapPut(map, key, value) // Thread-safe put
    any ds_concurrentHashMapGet(map, key) // Thread-safe get
    any ds_concurrentHashMapRemove(map, key) // Thread-safe remove
    bool ds_concurrentHashMapContains(map, key)
    number ds_concurrentHashMapSize(map)
    bool ds_concurrentHashMapIsEmpty(map)
    bool ds_concurrentHashMapClear(map)
    array ds_concurrentHashMapKeys(map) // Snapshot of keys
    bool ds_concurrentHashMapPutIfAbsent(map, key, value) // Only put if key doesn't exist
    bool ds_concurrentHashMapReplace(map, key, oldValue, newValue) // CAS operation
}

// ============================================
// Decorators & HTTP Route Registration
// ============================================
interface Decorators from "libs/libkylds.so" {
    // Decorator registry
    number ds_decoratorCreate(name, funcName) // Create decorator entry
    bool ds_decoratorAddMetadata(decoratorId, key, value) // Add metadata
    any ds_decoratorGetMetadata(decoratorId, key)
    array ds_decoratorList() // List all decorators
    
    // HTTP Route registration (common decorator use case)
    bool ds_routeRegister(method, path, handlerFunc) // Register HTTP route
    bool ds_routeRegisterRegex(method, pathRegex, paramNames, handlerFunc) // With regex
    object ds_routeFind(method, path) // Find matching route, returns {handler, params}
    array ds_routeList() // List all routes
    bool ds_routeClear() // Clear all routes
    
    // Generic function metadata (for any decorator pattern)
    bool ds_metaSet(funcName, key, value) // Store metadata for function
    any ds_metaGet(funcName, key) // Get metadata
    object ds_metaGetAll(funcName) // Get all metadata as object
    bool ds_metaHas(funcName, key) // Check if metadata exists
}

// Vector Operations for ML/AI
// ============================================
interface VectorOps from "libs/libkylds.so" {
    // Basic vector operations
    number ds_vectorDotProduct(vec1, vec2) // Dot product of two vectors
    number ds_vectorMagnitude(vec) // L2 norm (magnitude) of vector
    array ds_vectorNormalize(vec) // Normalize to unit vector
    
    // Similarity and distance metrics
    number ds_vectorCosineSimilarity(vec1, vec2) // Cosine similarity [-1, 1]
    number ds_vectorEuclideanDistance(vec1, vec2) // L2 distance
    number ds_vectorManhattanDistance(vec1, vec2) // L1 distance
    
    // Vector arithmetic
    array ds_vectorAdd(vec1, vec2) // Element-wise addition
    array ds_vectorSubtract(vec1, vec2) // Element-wise subtraction
    array ds_vectorScale(vec, scalar) // Scalar multiplication
}

// K-Nearest Neighbors & Similarity Search
// ============================================
interface KNN from "libs/libkylds.so" {
    // KNN search
    array ds_knnFind(queryVec, dataset, k, metric) // Find K nearest neighbors, returns indices
    array ds_knnFindWithDistances(queryVec, dataset, k, metric) // Returns [{index, distance}, ...]
    array ds_knnFindByThreshold(queryVec, dataset, threshold, metric) // Find all within threshold
    array ds_knnSimilarityMatrix(dataset, metric) // Compute pairwise distances
}
