// Machine Learning Library Interface for Kuyil
// Scikit-learn style ML algorithms
// Provides: Clustering, Regression, Metrics (more coming soon)

// ============================================
// K-Means Clustering
// ============================================
interface KMeans from "libs/libkylml.so" {
    // Create K-Means model
    // Args: n_clusters, max_iterations, tolerance
    number ml_kmeansCreate(n_clusters, max_iterations, tolerance)
    
    // Fit model to data
    // Args: model, dataset (array of vectors), n_samples
    // Returns: converged (boolean)
    bool ml_kmeansFit(model, dataset)
    
    // Predict cluster labels for new data
    // Args: model, dataset
    // Returns: array of cluster labels (integers)
    array ml_kmeansPredict(model, dataset)
    
    // Fit and predict in one step
    array ml_kmeansFitPredict(model, dataset)
    
    // Get cluster centers
    // Returns: array of center vectors
    array ml_kmeansGetCenters(model)
    
    // Get inertia (sum of squared distances to centers)
    number ml_kmeansGetInertia(model)
    
    // Get number of iterations performed
    number ml_kmeansGetIterations(model)
    
    // Save model to file
    // Args: model, filename (string)
    // Returns: success (boolean)
    bool ml_kmeansSave(model, filename)
    
    // Load model from file
    // Args: filename (string)
    // Returns: model handle
    number ml_kmeansLoad(filename)
    
    // Destroy model
    bool ml_kmeansDestroy(model)
}

// ============================================
// Linear Regression
// ============================================
interface LinearRegression from "libs/libkylml.so" {
    // Create linear regression model
    // Args: fit_intercept (boolean), method ("normal" or "gradient_descent")
    number ml_linearRegressionCreate(fit_intercept, method)
    
    // Fit model to training data
    // Args: model, X (features), y (targets)
    bool ml_linearRegressionFit(model, X, y)
    
    // Predict targets for new data
    // Args: model, X (features)
    // Returns: array of predicted values
    array ml_linearRegressionPredict(model, X)
    
    // Get coefficients (weights)
    array ml_linearRegressionGetCoefficients(model)
    
    // Get intercept (bias)
    number ml_linearRegressionGetIntercept(model)
    
    // Calculate R² score
    number ml_linearRegressionScore(model, X, y)
    
    // Save model to file
    // Args: model, filename (string)
    // Returns: success (boolean)
    bool ml_linearRegressionSave(model, filename)
    
    // Load model from file
    // Args: filename (string)
    // Returns: model handle
    number ml_linearRegressionLoad(filename)
    
    bool ml_linearRegressionDestroy(model)
}

// ============================================
// ML Metrics
// ============================================
interface MLMetrics from "libs/libkylml.so" {
    // Classification Metrics
    number ml_accuracyScore(y_true, y_pred)
    number ml_precisionScore(y_true, y_pred)
    number ml_recallScore(y_true, y_pred)
    number ml_f1Score(y_true, y_pred)
    array ml_confusionMatrix(y_true, y_pred)
    
    // Regression Metrics
    number ml_meanSquaredError(y_true, y_pred)
    number ml_rootMeanSquaredError(y_true, y_pred)
    number ml_meanAbsoluteError(y_true, y_pred)
    number ml_r2Score(y_true, y_pred)
    
}

// Note: Available now:
// ✓ K-Means Clustering (k-means++)
// ✓ Linear Regression (gradient descent)
// ✓ Classification Metrics (accuracy, precision, recall, F1, confusion matrix)
// ✓ Regression Metrics (MSE, RMSE, MAE, R²)
//
// Coming soon (implementations ready, need API fixes):
// - Logistic Regression
// - KNN Classifier  
// - StandardScaler / MinMaxScaler
// - Train/test split utilities
// - PCA (dimensionality reduction)
