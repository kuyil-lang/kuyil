// Interface for HTTP library
@loadlib("./libs/libkylhttp.so");

// HTTP Server functions
interface http {
  int32 server(port: int32)
  bool get(path: string, handler: string)
  bool post(path: string, handler: string)
  bool put(path: string, handler: string)
  bool delete(path: string, handler: string)
  bool listen(port: int32)
  bool startServer(port: int32)
  bool registerRoute(method: string, path: string, handler: string)
  string clientGet(url: string)
  string clientPost(url: string, body: string)
  bool cleanup()
  bool static(root: string)
  bool staticAdd(route: string, dir: string)
  bool staticBypass(path: string)
  bool staticBypassClear()
}

// Response builder functions
interface response {
  bool setStatus(response: int32, status: int32)
  bool setBody(response: int32, body: string)
  bool setJson(response: int32, json: string)
  bool addHeader(response: int32, name: string, value: string)
}

// Request accessor functions
interface request {
  string getMethod(request: int32)
  string getPath(request: int32)
  string getBody(request: int32)
  string getParam(request: int32, name: string)
  string getHeader(request: int32, name: string)
  bool parseMultipart(request: int32)
  string getMultipartField(request: int32, name: string)
  array parseMultipartFields(request: int32)
  object parseMultipartFile(request: int32, fieldname: string)
  bool saveMultipartFile(request: int32, fieldname: string, destpath: string)
  string getJsonString(request: int32, path: string)
  float64 getJsonNumber(request: int32, path: string)
  bool getJsonBool(request: int32, path: string)
}

