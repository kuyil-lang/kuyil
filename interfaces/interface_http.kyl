// Interface for HTTP library
@loadlib("./libs/libkylhttp.so");

// HTTP Server functions
interface http {
  number server()
  bool get(path: string, handler: string)
  bool post(path: string, handler: string)
  bool put(path: string, handler: string)
  bool delete(path: string, handler: string)
  bool listen(port: number)
  bool register_route(method: string, path: string, handler: string)
  string client_get(url: string)
  string client_post(url: string, body: string)
  bool cleanup()
  bool static(root: string)
  bool static_add(route: string, dir: string)
  bool static_bypass(path: string)
  bool static_bypass_clear()
}

// Response builder functions
interface response {
  bool set_status(response: number, status: number)
  bool set_body(response: number, body: string)
  bool set_json(response: number, json: string)
  bool add_header(response: number, name: string, value: string)
}

// Request accessor functions
interface request {
  string get_method(request: number)
  string get_path(request: number)
  string get_body(request: number)
  string get_param(request: number, name: string)
  string get_header(request: number, name: string)
  bool parse_multipart(request: number)
  string get_multipart_field(request: number, name: string)
  array parse_multipart_fields(request: number)
  object parse_multipart_file(request: number, fieldname: string)
  bool save_multipart_file(request: number, fieldname: string, destpath: string)
  string get_json_string(request: number, path: string)
  number get_json_number(request: number, path: string)
  bool get_json_bool(request: number, path: string)
}

