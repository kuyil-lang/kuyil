// Interface for Date/Time library
// Datetime-specific helpers
interface datetime from "libs/libkyldatetime.so" {
  @alias("now")
  string datetime_now()
  
  @alias("current")
  string datetime_current()
}

// Date helpers
interface date {
  @alias("now")
  string date_now()
  
  @alias("unix")
  int64 date_unix()
  
  @alias("iso")
  string date_iso(date: string)
}
