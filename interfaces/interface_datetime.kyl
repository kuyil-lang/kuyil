// Interface for Date/Time library
// Load library at runtime
loadlib("libs/libkyldatetime.so")

// Datetime-specific helpers
interface datetime {
  @alias("now")
  string datetime_now()
  
  @alias("current")
  string datetime_current()
}

// Date helpers
interface date {
  @alias("now")
  string date_now()
  
  @alias("unix")
  int64 date_unix()
  
  @alias("iso")
  string date_iso(date: string)
}
