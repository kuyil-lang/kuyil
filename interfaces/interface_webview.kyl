// Interface for WebView library
interface webview from "libs/libkylwebview.so" {
  // Initialization and cleanup
  bool   init()
  void   cleanup()
  
  // Window creation and management
  int32  createDefaultSettings()
  int32  create(title: string, settings: int32)
  bool   destroy(window: int32)
  bool   show(window: int32)
  bool   hide(window: int32)
  
  // Content loading
  bool   loadHtml(window: int32, html: string)
  bool   loadUrl(window: int32, url: string)
  
  // Window control
  int32  run(window: int32)
  bool   step(window: int32)
  bool   is_open(window: int32)
  bool   setTitle(window: int32, title: string)
  bool   setSize(window: int32, width: int32, height: int32)
  
  // JavaScript execution - CRITICAL for Kuyil→JS communication
  // Use full C function name, provide short name as alias
  // C function: kyl_webview_eval
  // Execute JavaScript code in the WebView
  // Example: webview_eval(win, "alert('Hello from Kuyil!');")
  @alias("eval")
  bool   webview_eval(window: int32, js_code: string)
  
  // JavaScript→Kuyil bridge
  // Use full C function name to avoid conflicts, provide short name as alias
  // C function: kyl_webview_bind
  // Binds a Kuyil function to be callable from JavaScript
  // Usage: webview_bind(win, "test", test) or bind(win, "test", test)
  // JavaScript can then call: window.test("arg")
  @alias("bind")
  bool   webview_bind(window: int32, func_name: string, callback: function)
  
  // Developer tools
  bool   enableDevTools(window: int32, enable: bool)
}