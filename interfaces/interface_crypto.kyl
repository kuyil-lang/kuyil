// Interface for Crypto library
@loadlib("./libs/libkylcrypto.so");

interface crypto {
  string md5(input: string)
  string sha256(input: string)
  string sha512(input: string)
  string blake2b(input: string)

  string base64Encode(input: string)
  string base64Decode(input: string)

  // Random helpers
  bool randomInit()
  string randomHex(length: int32)
  int32 randomInt(min: int32, max: int32)
  string generateUuid()
  string generateToken(length: int32)
}
