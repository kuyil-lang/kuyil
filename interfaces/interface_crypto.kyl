// Interface for Crypto library
// Load library at runtime
loadlib("libs/libkylcrypto.so")

interface crypto {
  @alias("md5")
  string crypto_md5(input: string)
  
  @alias("sha256")
  string crypto_sha256(input: string)
  
  @alias("sha512")
  string crypto_sha512(input: string)
  
  @alias("blake2b")
  string crypto_blake2b(input: string)

  @alias("base64Encode")
  string crypto_base64Encode(input: string)
  
  @alias("base64Decode")
  string crypto_base64Decode(input: string)

  // Random helpers
  @alias("randomInit")
  bool crypto_randomInit()
  
  @alias("randomHex")
  string crypto_randomHex(length: int32)
  
  @alias("randomInt")
  int32 crypto_randomInt(min: int32, max: int32)
  
  @alias("generateUuid")
  string crypto_generateUuid()
  
  @alias("generateToken")
  string crypto_generateToken(length: int32)
}
